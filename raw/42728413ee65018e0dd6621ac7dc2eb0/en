["Ester_Food.sq"]={
	["6dcb600e893d11ea97073c15c2dd513c"] = "Você {<}AINDA não terminou?";
	["6dcb607c893d11ea97073c15c2dd513c"] = "Aff! Não aguento mais!\n{====}Escolhe logo alguma coisa! O que tem de errado com morango?";
	["5bece34ec75411ea99c93c15c2dd513c"] = "Mas eu tomei morango ontem.";
	["5bece452c75411ea99c93c15c2dd513c"] = "Então que tal melancia?";
	["5bece600c75411ea99c93c15c2dd513c"] = "Você não lembra? A gente tomou melancia anteontem.\n{====}E o dia antes disso, banana.\n{====}E antes disso, morango, limão, uva...";
	["5bece718c75411ea99c93c15c2dd513c"] = "Aff! Sabe de quê? Tanto faz. Vou parar de falar.\n{====}Você fica à vontade pra escolher com calma.";
	["5bece902c75411ea99c93c15c2dd513c"] = "Eu realmente devia ficar de boca fechada.";
	["5becea06c75411ea99c93c15c2dd513c"] = "Se eu comprar morango hoje... amanhã devo comprar uva...\n{====}Escolher o sabor de um profiterole não é coisa pra levar na brincadeira...";
	["5beceb32c75411ea99c93c15c2dd513c"] = "Qual a coisa mais importante quando uma catástrofe se aproxima?\n{====}Ora, um estoque amplo de alimentos, claro.\n{====}Pra nós robôs, isso significa etanol de sobra!";
	["5beceb96c75411ea99c93c15c2dd513c"] = "Mas não pra mim, não. Eu TERMINEI com álcool, terminei.\n{====}Não quero nenhum. Definitivamente não quero nenhum.";
	["5becec90c75411ea99c93c15c2dd513c"] = "Mas não pra mim, não. Eu TERMINEI com álcool, terminei.\n{====}Não quero nenhum. Definitivamente não quero nenhum.";
	["5beced12c75411ea99c93c15c2dd513c"] = "Droga, eu bem que podia tomar um drinque agora...\n{====}Não, não, não! Seu velho bêbado. É só meio-dia!\n{====}Eu tenho que aguentar. Tenho que!";
	};
["Dockyard.sq"]={
	["6da672d0893d11ea97073c15c2dd513c"] = "Esperem por mim...{stop}";
	["6da67636893d11ea97073c15c2dd513c"] = "Vem comigo, vocês dois.\n{====}Não queremos deixar nosso cliente esperando agora, né?";
	["6da685c2893d11ea97073c15c2dd513c"] = "Vocês não têm interesse no fruto do futuro?";
	["6da68770893d11ea97073c15c2dd513c"] = "{big}Eu sou matemático, então não é como se eu soubesse muito sobre plantas e frutas e tal.\n{====}{big}Mas não pense nem por um segundo que pode me enganar.\n{====}Não vou comer essa desculpa de fruta!";
	["6da689e6893d11ea97073c15c2dd513c"] = "Olha só, John! Você vai na minha apresentação amanhã?\n{====}Vou mostrar um tipo novinho de fruta.\n{====}E você ainda vai poder comer ela!";
	["6da68bbc893d11ea97073c15c2dd513c"] = "Você não tá falando daquela sandrupe, né?\n{====}Não sei como você pode chamar algo incomestível de \"fruta\"!";
	["6da68cf2893d11ea97073c15c2dd513c"] = "Não fala mal da sandrupe! Ela é durona!\n{====}Quase não precisa de luz. Até cresce debaixo da terra!\n{====}Tô te dizendo—é a fruta do futuro!";
	["6da68ee6893d11ea97073c15c2dd513c"] = "Se é isso que me espera no futuro, bem...\n{====}Posso bem descer deste trem agora mesmo.";
	["5be8447ec75411ea99c93c15c2dd513c"] = "Vou na frente pra \"lá\", então.";
	["5be845d2c75411ea99c93c15c2dd513c"] = "{~}Entendido!\n{==}Ainda temos um pouco de preparo pra fazer aqui.\n{====}Na hora certa, a gente se encontra \"lá\".";
	["5be846eac75411ea99c93c15c2dd513c"] = "Sim!";
	["5be847b2c75411ea99c93c15c2dd513c"] = "Vem comigo, vocês dois.";
	["5be84960c75411ea99c93c15c2dd513c"] = "Receio que não podemos ajudar a entregar cartas hoje, Cap'n.";
	["5be84a82c75411ea99c93c15c2dd513c"] = "Arrrrr, e por quê?";
	["5be84bf4c75411ea99c93c15c2dd513c"] = "Temos algo SUPER importante pra dar pro nosso amigo Daniel.";
	["5be84e4cc75411ea99c93c15c2dd513c"] = "Um amigo, é? Então acho que isso é motivo suficiente.\n{====}Vão lá então, seus cães sarnentos!\n{==}Não tem nada mais importante que um amigo. Har har har har!";
	["5be84f6ec75411ea99c93c15c2dd513c"] = "Vem comigo... vocês... dois?";
	["5be8531ac75411ea99c93c15c2dd513c"] = "Receio que não podemos ajudar a entregar cartas hoje, Cap'n.";
	["5be85478c75411ea99c93c15c2dd513c"] = "Arrrrr, e por quê?";
	["5be8569ec75411ea99c93c15c2dd513c"] = "A gente tá indo pra Torre de Eternia!\n{====}Nossa amiga Isabel foi pra lá.\n{====}E ela é uma amiga super, super, SUPER importante!\n{====}A gente tem que encontrá-la!";
	["5be8577ac75411ea99c93c15c2dd513c"] = "Um amigo, é?\n{====}Bem, não tem nada mais importante que um amigo.\n{====}Mas vocês deviam saber que entrar na Torre de Eternia... não vai ser fácil.";
	["5be857d4c75411ea99c93c15c2dd513c"] = "A gente sabe que a Isabel usou a Chama do Tempo pra abrir a porta!\n{====}O senhor não saberia onde a gente pode achar ela, né, Cap'n?";
	["5be859dcc75411ea99c93c15c2dd513c"] = "Já tão tão longe assim, são...?";
	["5be85aeac75411ea99c93c15c2dd513c"] = "Receio que não sei onde tá a chama eu mesmo.\n{====}Porém, se aquela amiga de vocês conseguiu entrar na torre...\n{====}...então deve estar em algum lugar aqui na Cidade de Eternia.\n{====}Em algum lugar que vocês não vão simplesmente tropeçar.";
	["5be85c0cc75411ea99c93c15c2dd513c"] = "Espera, eu sei! A gente pode usar o Punk Sônico!";
	["5be85ca2c75411ea99c93c15c2dd513c"] = "Por favor nos leve pra Isabel, Sr. O Punk Sônico!";
	["5be85cfcc75411ea99c93c15c2dd513c"] = "Comando recebido.\n{====}Procurando por: Isabel...";
	["5be85e00c75411ea99c93c15c2dd513c"] = "Se vocês tiverem algum problema, chamem o velho Thomas.\n{====}Vocês o encontram no Cemitério de Trens.";
	["5be85e8cc75411ea99c93c15c2dd513c"] = "Cemitério de Trens—entendi!\n{====}Valeu, Cap'n Pam!";
	["5be85f90c75411ea99c93c15c2dd513c"] = "É melhor irem logo, seus pirralhos.";
	["5be86008c75411ea99c93c15c2dd513c"] = "E eu também tenho trabalho pra fazer...";
	["5be86166c75411ea99c93c15c2dd513c"] = "Cap'n! A gente vai entrar na Torre de Eternia hoje.\n{====}Então não vamos poder ajudar a entregar cartas.";
	["5be86210c75411ea99c93c15c2dd513c"] = "{<}É mesmo, hein?\nÉ mesmo...\n{====}{|}{big}Então vocês, devem ter achado a Chama do Tempo, né?";
	["5be86260c75411ea99c93c15c2dd513c"] = "Achamos sim! Estava debaixo do túmulo do Solomon.";
	["5be862a6c75411ea99c93c15c2dd513c"] = "Estava {<<}lá o tempo todo, era...?";
	["5be863b4c75411ea99c93c15c2dd513c"] = "{~}Har har har har har!\n{~~}HAR HAR HAR HAR HAR!\n{====}Então o dia finalmente chegou!";
	["5be864b8c75411ea99c93c15c2dd513c"] = "Desculpa o surto, mas não consegui me conter.\n{====}Vão lá agora, seus pirralhos.\n{====}E se precisarem de algo, estaremos aí pra ajudar.";
	["5be86698c75411ea99c93c15c2dd513c"] = "Cap'n Pam, o senhor realmente... não lembra de nada?";
	["5be867b0c75411ea99c93c15c2dd513c"] = "{<}Arrr... {| }Receio que nada vem à velha cabeça, não.\n{====}A gente... esqueceu muitas coisas com o tempo.\n{====}Mas ainda tem coisas que o coração não deixa esquecer...\n{====}{big}Não importa o quanto você queira esquecer. Não é mesmo, Sammie pequena?";
	["5be86986c75411ea99c93c15c2dd513c"] = "{~}O senhor LEMBRA!";
	["5be86a1cc75411ea99c93c15c2dd513c"] = "Vamos pra torre então!\n{====}E vamos definitivamente—DEFINITIVAMENTE—trazer Alva e Isabel de volta!";
	["1b6642cc2ca111eb801b3c15c2dd513c"] = "Vem comigo, vocês dois.\n{====}Não queremos deixar nosso cliente esperando agora, né?";
	["1b66459c2ca111eb801b3c15c2dd513c"] = "{~}Espera!";
	["1b6646822ca111eb801b3c15c2dd513c"] = "Vocês não poderiam entregar umas coisas pra mim, poderiam?";
	["1b66472c2ca111eb801b3c15c2dd513c"] = "{big}Acho que eu estaria disposto a emprestar meu pessoal de entregas pra vocês por um tempo.";
	["1b6649d42ca111eb801b3c15c2dd513c"] = "Tenho uma carta pro Guy na Red Rocket Repair...\n{====}Uma pro Frank no Cemitério de Trens...\n{====}E uma pro Ivan no Hotel Eternia.\n{====}Me procurem de volta no cais quando terminarem.";
	};
