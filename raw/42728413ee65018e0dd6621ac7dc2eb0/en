	};
["EastUp.sq"]={
	["5bec6b08c75411ea99c93c15c2dd513c"] = "{big}Eu te digo, se isso te incomoda...\n{====}Eu peço demissão da universidade agora mesmo. Peço sim!";
	["5bec6d10c75411ea99c93c15c2dd513c"] = "Não, não! Você não pode! Eu nunca...";
	["5bec6dc4c75411ea99c93c15c2dd513c"] = "E... e de verdade, eu tô... felicíssima com seus sentimentos por mim...\n{====}{big}Só tô preocupada com o que os outros vão pensar. Você é meu professor, afinal...";
	["5bec6ed2c75411ea99c93c15c2dd513c"] = "Não me importa o que ninguém pensa!";
	["5bec701cc75411ea99c93c15c2dd513c"] = "Por favor não fica chateado, eu só... talvez eu... precise conversar com minha irmã...";
	["5bec7076c75411ea99c93c15c2dd513c"] = "Eu só me importo com o que VOCÊ pensa.\n{====}Por favor, só me diz como você se sente.";
	["5bec70d0c75411ea99c93c15c2dd513c"] = "Eu... hum... Buchan, tem gente olhando pra gente.";
	["5bec7120c75411ea99c93c15c2dd513c"] = "...";
	["5bec7198c75411ea99c93c15c2dd513c"] = "Desculpa, hm... tem algo que a gente possa fazer pra ajudar?";
	["5bec73d2c75411ea99c93c15c2dd513c"] = "Não acho que isso diga respeito a vocês...";
	["5bec7468c75411ea99c93c15c2dd513c"] = "Meu professor, ém... quer dizer... este senhor...\n{====}Não, meu PARCEIRO, ele... Eu... Eu gostaria muito de casar com ele, mas...\n{====}Ele é meu professor, sabe...";
	["5bec74c2c75411ea99c93c15c2dd513c"] = "O que você acabou de dizer?";
	["5bec7526c75411ea99c93c15c2dd513c"] = "Ém... você é meu professor?";
	["5bec758ac75411ea99c93c15c2dd513c"] = "Não, não. Antes disso.";
	["5bec767ac75411ea99c93c15c2dd513c"] = "Eu gostaria... muito de, ém... casar com você?";
	["5bec76e8c75411ea99c93c15c2dd513c"] = "{~}HAHA! {~}HAHAHAHAHA!\n{====}Então não preciso me preocupar mais!\n{====}Meu coração tá claro como o céu da Cidade de Eternia!\n{====}Não posso agradecer o suficiente, suas duas almas gentis!";
	["5bec7742c75411ea99c93c15c2dd513c"] = "O céu da Cidade de Eternia...?";
	["5bec78fac75411ea99c93c15c2dd513c"] = "Você realmente é um anjo, minha querida jovem amiga.\n{====}É o que dizem todas as lendas antigas, sabe.\n{====}{big}Que os anjos descerão ao mundo durante a estação branca.\n{====}HAHAHAHA!!";
	["5bec7a30c75411ea99c93c15c2dd513c"] = "Talvez... o Buchan tenha razão.\n{====}Eu realmente tô me preocupando demais com o que os outros pensam.";
	};
["CH_Buchan.sq"]={
	["6dc69420893d11ea97073c15c2dd513c"] = "Pobre Solomon... não diferente desse navio pobretão...";
	["5c299b04c75411ea99c93c15c2dd513c"] = "Por que tá tão absurdamente frio aqui...\n{====}Tudo que quero é terminar meu estudo e tomar um drinque no bar.";
	["5c299cb2c75411ea99c93c15c2dd513c"] = "Lada? Você quer dizer aquela minha aluna?\n{====}Por quê? Vocês dois se conhecem?\n{====}Ela é uma aluna bem esperta, admito.\n{====}Sem dúvida, vai virar uma ótima acadêmica um dia.";
	["5c299e10c75411ea99c93c15c2dd513c"] = "O quê? C-casada?!\n{====}Ela é minha aluna, droga!\n{====}Não vou deixar vocês difamarem ela assim!";
	["5c299f28c75411ea99c93c15c2dd513c"] = "Me deixa em paz! Não tenho nada pra falar com vocês!";
	};
