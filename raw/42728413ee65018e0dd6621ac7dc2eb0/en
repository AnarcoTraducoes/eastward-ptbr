["CH_Ro.sq"]={
	["1b9813562ca111eb801b3c15c2dd513c"] = "Com licença, mas o senhor não seria o Sr. Agu, seria?";
	["1b9815402ca111eb801b3c15c2dd513c"] = "O quê? Por que, sim. Sou eu. Por quê?";
	["1b98173e2ca111eb801b3c15c2dd513c"] = "Ah, ótimo! Temos uma entrega para o senhor!";
	["1b98190a2ca111eb801b3c15c2dd513c"] = "Entrega?\n{====}Estupendo! O número deste mês finalmente chegou, não é?";
	["1b981aae2ca111eb801b3c15c2dd513c"] = "Deixe-me ver, deixe-me ver...\n{====}Meu artigo com certeza, COM CERTEZA deve estar aqui dentro...";
	["1b981c2a2ca111eb801b3c15c2dd513c"] = "{~}O quê?! Por que não está aqui?!\n{====}Os editores não compreendem plenamente o valor da minha teoria?!";
	["1b981dce2ca111eb801b3c15c2dd513c"] = "Sr. Agu, temos uma entrega para o senhor.";
	["1b981ec82ca111eb801b3c15c2dd513c"] = "Ainda que... acho que talvez o senhor não fique muito feliz com isso.\n{====}Seu artigo não está lá....";
	["1b981f722ca111eb801b3c15c2dd513c"] = "O quê?! Aqueles malditos editores! Eu devia ter imaginado!";
	["1b9821842ca111eb801b3c15c2dd513c"] = "O quê? Aqui para zombar de mim também, é? \n{====}{big}Só quem não tem nada de bom para dizer se esforça para falar com os outros aqui.";
	};
["CH_Lasse.sq"]={
	["6dc84572893d11ea97073c15c2dd513c"] = "Finalmente terminado.\n{====}Pronto pra voltar pra cidade, estamos?\n{====}Charon passa pela cidade amanhã, sabe.\n{====}{big}Se não começar a se preparar agora, vai perder todas as festividades.";
	["6dc846d0893d11ea97073c15c2dd513c"] = "Finalmente terminado.\n{====}Pronto pra voltar pra cidade, estamos?\n{====}Charon passa pela cidade amanhã, sabe.";
	["6dc848b0893d11ea97073c15c2dd513c"] = "Você disse a mesma coisa ontem.";
	["6dc8496e893d11ea97073c15c2dd513c"] = "O funeral terminou. Vocês deveriam ir embora.\n{====}Deixe o Solomon descansar em paz.";
	};
