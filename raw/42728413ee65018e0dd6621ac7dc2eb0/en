["TowerBottom.sq"]={
	["6dc53ff8893d11ea97073c15c2dd513c"] = "Pesquisa concluída. Encontrado: Isabel.";
	["6dc54124893d11ea97073c15c2dd513c"] = "{{~}Você conseguiu!";
	["6dc542f0893d11ea97073c15c2dd513c"] = "{{~}Isabel!";
	["6dc543ae893d11ea97073c15c2dd513c"] = "{{~}ISABEEEEL! EEEI!";
	["6dc54412893d11ea97073c15c2dd513c"] = "Finalmente, depois de todo esse tempo...{.}\n{====}{{~}Você está ouvindo aí em cima, sua torre desgraçada?!\n{==}{{~}É melhor abrir essa boca amaldiçoada sua...\n{====}Porque essa espinha na sua garganta... está entrando!";
	["6dc54548893d11ea97073c15c2dd513c"] = "Eu vou subir... e vou acabar com isso de uma vez por todas.\n{====}Alva...";
	["6dc547e6893d11ea97073c15c2dd513c"] = "{{~}Alva!";
	["6dc548ea893d11ea97073c15c2dd513c"] = "A Alva está aqui também?!";
	["6dc54b42893d11ea97073c15c2dd513c"] = "{{~}Qu-quem... quem está aí?!\n{====}Mostre-se!";
	["6dc54c0a893d11ea97073c15c2dd513c"] = "Isabel!\n{====}Você pode me ver? Hein? Isabel! Eu estou bem aqui!";
	["6dc54c78893d11ea97073c15c2dd513c"] = "Deve estar vendo coisas...";
	["6dc54f02893d11ea97073c15c2dd513c"] = "Vamos. Vamos.";
	["6dc55178893d11ea97073c15c2dd513c"] = "John! A Isabel entrou! Ela entrou na torre!";
	["6dc552fe893d11ea97073c15c2dd513c"] = "Chama da esperança.";
	["6dc553da893d11ea97073c15c2dd513c"] = "Abra o caminho do desespero.";
	["6dc55470893d11ea97073c15c2dd513c"] = "Vamos, John! Vamos!";
	["5c27b9bac75411ea99c93c15c2dd513c"] = "{{~}Sr. The Sonic Punk!";
	["5c27bac8c75411ea99c93c15c2dd513c"] = "{{~}Sr. The Sonic Puuuuunk!{.}\n{====}Onde é isso?\nA Eternal... Tower...?";
	["5c27bcd0c75411ea99c93c15c2dd513c"] = "Exato!{stop}";
	["5c27bde8c75411ea99c93c15c2dd513c"] = "A Torre de Eternia... a raiz de todo mal.";
	["5c27bff0c75411ea99c93c15c2dd513c"] = "A sombra profunda na gaiola vazia engole toda luz.";
	["5c27c090c75411ea99c93c15c2dd513c"] = "A sombra profunda na gaiola vazia engole toda luz.";
	["1b904e3c2ca111eb801b3c15c2dd513c"] = "Aquela porta...";
	["1b9051f22ca111eb801b3c15c2dd513c"] = "...leva ao esconderijo do Solomon.\n{====}E a única coisa que pode abri-la... é a Chama do Tempo.";
	["1b9054222ca111eb801b3c15c2dd513c"] = "A Chama do Tempo?";
	["1b90558a2ca111eb801b3c15c2dd513c"] = "É uma invenção do Solomon.\n{====}Basicamente, uma bola de energia concentrada.";
	["1b9058c82ca111eb801b3c15c2dd513c"] = "O cara tá morto agora, né?\n{====}Então pra onde a chama foi parar?";
	["1b905de62ca111eb801b3c15c2dd513c"] = "HEM!\n{====}Posso dizer algumas palavras?";
	["1b905fbc2ca111eb801b3c15c2dd513c"] = "Se a Isabel conseguiu achar a chama...\n{====}{big}...então a Isabel é a nossa pista. Se a seguirmos, devemos achar a chama!";
	["1b90612e2ca111eb801b3c15c2dd513c"] = "Parece que vamos ter que contar com esse pequenino, então!";
	["1b9065162ca111eb801b3c15c2dd513c"] = "Se eu me lembro bem, a Isabel usou a chama pra acender essas coisas...\n{====}Mas como ela fez isso?";
	["1b9066ec2ca111eb801b3c15c2dd513c"] = "Essas são as Gaiolas do Tempo.";
	["1b9069582ca111eb801b3c15c2dd513c"] = "{{~}Capitão Pam!";
	["1b906aca2ca111eb801b3c15c2dd513c"] = "Vocês... vocês todos estão aqui!\n{====}Então vocês não esqueceram!";
	["1b9070602ca111eb801b3c15c2dd513c"] = "{big}Esquecer as coisas não é tão ruim, pra ser honesto. Deixa você lembrar de novo.";
	["1b9071b42ca111eb801b3c15c2dd513c"] = "O velho Thomas aqui nos contou tudo.\n{====}O que aconteceu no passado... e o que aconteceu ontem.";
	["1b9072c22ca111eb801b3c15c2dd513c"] = "Sobre a chama também.";
	["1b90739e2ca111eb801b3c15c2dd513c"] = "Você sabe como eu devo acender essas coisas então?\n{====}Tipo como a Isabel fez?";
	["1b9074662ca111eb801b3c15c2dd513c"] = "Essa coisa é do design do Solomon.\n{====}Contanto que você tenha a Chama do Tempo, deve conseguir abrir a porta.\n{====}Você só precisa focar... focar na chama nas suas mãos...";
	["1b90752e2ca111eb801b3c15c2dd513c"] = "Focar na... chama nas minhas... mãos...";
	["1b9076e62ca111eb801b3c15c2dd513c"] = "Focar na... chama...";
	["1b90797a2ca111eb801b3c15c2dd513c"] = "Arrr, que coisa impressionante, isso...";
	["1b907b6e2ca111eb801b3c15c2dd513c"] = "A porta deve abrir agora, né?";
	["1b907cd62ca111eb801b3c15c2dd513c"] = "Parece que você ainda tá faltando uma coisa.";
	["1b907e662ca111eb801b3c15c2dd513c"] = "Uma coisa?";
	["1b907f1a2ca111eb801b3c15c2dd513c"] = "{big}Exato. E talvez seus amigos possam ajudar com essa.";
	["1b90805a2ca111eb801b3c15c2dd513c"] = "É AQUI que vamos fazer a operação, é?";
	["1b9082e42ca111eb801b3c15c2dd513c"] = "Heh. Deixa eu explicar!\n{====}Esse robozinho tem ENERGIA DEMAIS acumulada dentro dele.\n{====}Tanto que nenhum equipamento da minha loja consegue armazenar.";
	["1b90844c2ca111eb801b3c15c2dd513c"] = "Mas... mas... você já pegou nosso {~}DINHEIRO!";
	["1b9085fa2ca111eb801b3c15c2dd513c"] = "{big}Ei, ei, ei, vamos nos acalmar agora. Ainda não cheguei no principal!\n{====}Que é exatamente por isso... que vamos fazer a operação AQUI em vez disso!";
	["1b9087bc2ca111eb801b3c15c2dd513c"] = "Na f-frente dessa torre...?";
	["1b9089562ca111eb801b3c15c2dd513c"] = "Ah-HAH! Entendi!\n{====}Podemos usar a porta da Torre de Eternia pra absorver toda essa energia do cara!\n{====}Não só completando a operação, mas também abrindo a porta.\n{====}Seu gênio careca! Você realmente entende do assunto!\n{====}Bem, ainda não tanto quanto eu, no entanto.";
	["1b908ae62ca111eb801b3c15c2dd513c"] = "{{~}Que coisa! Você só queria ser tão esperto quanto eu!\n{====}{big}E eu não sou careca! Minha... minha linha do cabelo só recuou um pouco. Pro fundo da cabeça.";
	["1b908c582ca111eb801b3c15c2dd513c"] = "{{~}Ótimo! Você vai poder terminar sua operação, Daniel!";
	["1b9092982ca111eb801b3c15c2dd513c"] = "Se meus cálculos estiverem corretos...\n{====}A energia dentro dele deve ser exatamente o suficiente pra abrir essa porta.\n{====}O que deve finalizar a operação perfeitamente!";
	["1b909e3c2ca111eb801b3c15c2dd513c"] = "Mas não adianta eu ficar falando sobre isso.\n{====}A melhor prova é simplesmente tentar!";
	["1b90a0da2ca111eb801b3c15c2dd513c"] = "Vamos lá então, garoto.\n{====}Todas as nossas esperanças estão nos seus ombros de ferro!";
	["1b90a30a2ca111eb801b3c15c2dd513c"] = "{{~}T-tá bom!";
	["1b90a4902ca111eb801b3c15c2dd513c"] = "Hum...";
	["1b90a7062ca111eb801b3c15c2dd513c"] = "O que eu... d-d-deveria \nfazer...?";
	["1b90a8822ca111eb801b3c15c2dd513c"] = "Só ficar parado aí já deve resolver.";
	["1b90a9362ca111eb801b3c15c2dd513c"] = "Parado... a-aqui...?{stop}";
	["1b90aada2ca111eb801b3c15c2dd513c"] = "Finalmente, ela abre...";
	["1b90ac7e2ca111eb801b3c15c2dd513c"] = "Não tem mais nada no seu caminho agora.\n{====}Vai lá então, Sam.\n{====}A Legião dos Cavaleiros Rocket vai estar aqui esperando seu retorno triunfante.";
	["1b90ae682ca111eb801b3c15c2dd513c"] = "Vamos encontrar a Isabel! Eu sei disso!";
	["ab751812309211eb84b63c15c2dd513c"] = "Não é só impressão minha, né?\n{====}Ou aquela torre realmente parece... mais velha?";
	["ab751998309211eb84b63c15c2dd513c"] = "{{~}Har har har har har!\nEntão a hora chegou enfim...\n{====}Aposto que o velho Solomon nunca pensou que este dia chegaria.";
	["ab751aba309211eb84b63c15c2dd513c"] = "Como ela... entrou?\n{====}Suponho que temos que dar crédito à coragem dela.";
	["ab751b50309211eb84b63c15c2dd513c"] = "Quanta energia TINHA naquele garoto?\n{====}{big}Nunca pensei que viveria pra ver o dia em que alguém finalmente abriria essa porta.";
	["ab751bd2309211eb84b63c15c2dd513c"] = "{big}Arrrr, fico imaginando o que o meu eu do passado diria sobre tudo isso.";
	["ab751c36309211eb84b63c15c2dd513c"] = "Se eu tivesse que chutar, você provavelmente já teria xingado a porta...\n{====}...e depois ido afogar as mágoas de volta no cais.";
	["ab751cfe309211eb84b63c15c2dd513c"] = "Heh. Não lembro de você ter essa boca tão grande, Frank.";
	["ab751d80309211eb84b63c15c2dd513c"] = "Deve ser de andar com aquele robô sabichão o tempo todo.";
	["ab751df8309211eb84b63c15c2dd513c"] = "Usar a nova função desse cara é simples.\n{====}Assim que você chegar perto de uma Âncora do Tempo, a luz dele vai mudar de cor.\n{====}Só segue ele e você acerta em cheio.";
	["ab751e7a309211eb84b63c15c2dd513c"] = "O Ivan de repente disse que lembrou de algo e saiu correndo.\n{====}Nem trocou de roupa. Que cara.";
	["ab751ede309211eb84b63c15c2dd513c"] = "Ha! EU SABIA que minha teoria estava correta!\n{====}Essa porta é o recipiente perfeito.\n{====}Se eu tivesse um pouco mais de tempo, adoraria estudá-la mais.";
	["ab751fce309211eb84b63c15c2dd513c"] = "Ninguém mudou nadinha.\n{====}{big}Tenho que admitir, me sinto um pouco deslocado também, voltando tão rápido.";
	["ab7520fa309211eb84b63c15c2dd513c"] = "Já achou alguma coisa?\n{====}{big}Se eu tivesse que arriscar um palpite, diria que pode ter algo Baía dos Prazeres.";
	["ab75217c309211eb84b63c15c2dd513c"] = "Ninguém sabe o que tem naquela torre.\n{====}Se encontrar algo forte demais, não tenha medo de fugir.\n{====}Volte e reabasteça o que precisar.";
	["ab7521ea309211eb84b63c15c2dd513c"] = "Vencer sem usar nenhum Pixball é impressionante.\n{====}Mas não usar nenhum Pixball? Bem, isso não é tão divertido.\n{====}Você deveria saber disso melhor que todos nós, Mãe. Não, não. Sam.";
	["ab752244309211eb84b63c15c2dd513c"] = "Desculpa, mas receio que não possamos te seguir lá dentro.\n{====}O campo temporal dentro da Torre de Eternia é forte demais.\n{====}Nós... bem, provavelmente desapareceríamos...";
	["ab752294309211eb84b63c15c2dd513c"] = "Aleatoriamente, Thomas.\n{====}{big}Mas como você se ocupava naquela ilha sozinho?";
	["ab752384309211eb84b63c15c2dd513c"] = "Ah, você sabe. Pescando. Plantando coisas.\n{====}E se meu quadril não doesse, jogando umas rodadas de Earth Born.";
	["ab75241a309211eb84b63c15c2dd513c"] = "Ha!\n{====}Então você deve ser expert agora!";
	["ab75246a309211eb84b63c15c2dd513c"] = "Nah, nah. Quer dizer, eu consigo uma vitória apertada se tiver sorte.\n{====}Se eu tivesse uns Pixballs, porém...";
	["ab752618309211eb84b63c15c2dd513c"] = "{big}Caramba, o fato de você vencer sem Pixballs já é talento suficiente.\n{====}Tô falando mestre de Earth Born aqui!\n{====}Tenho certeza que nem o Guy fez isso!";
	["ab752730309211eb84b63c15c2dd513c"] = "{big}Ah, ha, ha, muito engraçado! Como se alguém pudesse ser melhor que o criador do jogo!";
	["ab752866309211eb84b63c15c2dd513c"] = "{big}E como se eu nunca tivesse te visto usar um Pixball ou dois na surdina durante a batalha!";
	["fec6775a526011eba6373c15c2dd513c"] = "{<}Então a... a operação foi... u-um sucesso?";
	["fec678fe526011eba6373c15c2dd513c"] = "Pode apostar que sim!\n{====}Essa energia anormal sua sumiu. Kaput!";
	["fec679b2526011eba6373c15c2dd513c"] = "Como você se sente, Daniel?";
	["fec67a70526011eba6373c15c2dd513c"] = "{<}Eu... não t-tô certo... principalmente só... cansado...";
	["fec67afc526011eba6373c15c2dd513c"] = "Efeito colateral da operação, sem dúvida.";
	["fec67b7e526011eba6373c15c2dd513c"] = "Ah...";
	["fec67c46526011eba6373c15c2dd513c"] = "Nós dois vamos nos aposentar, então.\n{====}Embora eu espere ansiosamente notícias do seu sucesso.";
	["fec67d18526011eba6373c15c2dd513c"] = "Tem certeza que você tá bem, Daniel?\n{====}Você parece bem fraco.";
	};
