["OutField_14.sq"]={
	["5c24f9e6c75411ea99c93c15c2dd513c"] = "O tempo aqui...\nNão está frio de jeito nenhum.\n{====}Mas não estava nevando agora há pouco?";
	["5c24fbf8c75411ea99c93c15c2dd513c"] = "Olha aquele helicóptero!\n{====}Tem que ser o lugar certo!";
	["5c24ff7cc75411ea99c93c15c2dd513c"] = "Alôôôôôô! O Sr. Thomas está aqui?";
	["5c2502c4c75411ea99c93c15c2dd513c"] = "{<}Cabelo branco... como neve recém-caída...\n{====}Mãe?";
	["5c25045ec75411ea99c93c15c2dd513c"] = "Meu nome é SAM! E eu não sou mãe de ninguém.\n{====}Você não é amigo daquele tal de Solomon, né?";
	["5c25059ec75411ea99c93c15c2dd513c"] = "Não, não... Acho que eu só...\n{====}Fiquei tempo demais nesta ilha...\n{====}O que vocês precisam de mim, então?";
	["5c2506b6c75411ea99c93c15c2dd513c"] = "O Capitão Pam pediu que viéssemos te procurar. O navio quebrou!\n{====}Mas precisamos voltar para Cidade de Eternia.";
	["5c25079cc75411ea99c93c15c2dd513c"] = "Me dá um segundo.";
	["5c2508dcc75411ea99c93c15c2dd513c"] = "Tá bom, então. Vamos lá.\n{====}Eu espero por vocês no cais.";
	["1b8ba44a2ca111eb801b3c15c2dd513c"] = "{{~}Quem é?!";
	["ab70451c309211eb84b63c15c2dd513c"] = "O Professor Ivan disse pra gente vir te procurar.\n{====}Ele disse que você pode saber algo sobre Isabel.";
	["ab7048aa309211eb84b63c15c2dd513c"] = ".......Você se importaria... de falar um pouco mais, seria? \n{====}É que, faz... muito tempo desde que ouvi essa voz.";
	["ab7049fe309211eb84b63c15c2dd513c"] = "Essa voz? Como assim?\n{====}Acabamos de vir de New Dam City.\n{====}Estamos procurando nossos amigos Alva e Isabel.\n{====}O Professor Ivan disse que você pode saber algo sobre eles?";
	["ab704a9e309211eb84b63c15c2dd513c"] = "Hum... alô...?";
	["ab704b20309211eb84b63c15c2dd513c"] = "Hã? Ah. Desculpa.\n{====}{big}Só. Ouvir você falar está me dando uma sobrecarga sensorial completa agora.\n{====}Enfim, não posso dizer que sei algo sobre esses seus amigos.\n{====}Mas algo me diz que eu... não... \"nós\" vamos poder ajudar vocês.\n{====}Esperem aqui um segundo.";
	["ab704c2e309211eb84b63c15c2dd513c"] = "Mas antes de eu ir, deixa eu te dar uma coisa.\n{====}Não vai ser fácil no caminho de volta.";
	["ab704dd2309211eb84b63c15c2dd513c"] = "Esta ilha... tem alguns segredos.\n{====}Pode te fazer bem procurá-los.\n{====}Tem algumas coisas que podem ser úteis pra você.";
	};
["CH_Capsule.sq"]={
	["5c29e122c75411ea99c93c15c2dd513c"] = "Tomara que o Frank não esteja doente ou algo assim.\n{====}Quem diria que um cérebro de zumbi como o dele poderia congelar!\n{====}Er, hum, Frank! Não quis dizer isso, parceiro! De verdade!";
	["ab785018309211eb84b63c15c2dd513c"] = "Está acontecendo algo com o Frank?\n{====}{big}No minuto em que acordou esta manhã, ele foi direto para a Torre de Eternia.";
	};
