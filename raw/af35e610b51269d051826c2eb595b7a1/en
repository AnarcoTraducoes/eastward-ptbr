["DamHall_Ch6.sq"]={
	["238a16d9174a11eabfc03c15c2dd513c"] = "Então, vocês estão nos deixando?";
	["238a19f0174a11eaaa4b3c15c2dd513c"] = "Éternia...\n{====}Meu avô me falou dela uma vez.\n{====}Uma cidade gelada nos confins do continente,\n{====}com uma torre imensa que se ergue até o céu...";
	["e7162b20ad6311eab5133c15c2dd513c"] = "A viagem será difícil, pode acreditar.\n{====}Mas ainda dá tempo de mudar de ideia.";
	["e7162cbaad6311eab5133c15c2dd513c"] = "Nem pensar! A gente não vai desistir!";
	["238a1c2b174a11ea981e3c15c2dd513c"] = "Vocês dois... São realmente extraordinários.\n{====}Possuem uma força que eu nem consigo imaginar.";
	["238a1e6e174a11ea9c153c15c2dd513c"] = "Como dizem...\n{====}{big}Mesmo o maior dos perdedores pode virar o jogo e conquistar o prêmio máximo.";
	["238a2242174a11ea810d3c15c2dd513c"] = "John!";
	["238a23e6174a11ea982d3c15c2dd513c"] = "Admirem esse corcel de metal!\nSerá nossa montaria.";
	["e7162e68ad6311eab5133c15c2dd513c"] = "{<}Apresento a vocês o Mosquete de Ferro!\n{====}Uma cabine de ferro forjado e a força motriz de cem cavalos!";
	["e7162f80ad6311eab5133c15c2dd513c"] = "É o que há de melhor em transporte.\n{====}E além disso, o motorista é excepcional.";
	["e716330ead6311eab5133c15c2dd513c"] = "Eu t... t... tenho quase c... certeza de que a palavra “e... excepcional” não é a mais certa...";
	["e7163444ad6311eab5133c15c2dd513c"] = "Muito bem, estão prontos pra pegar a estrada?\n{====}A viagem promete ser longa.\n{====}Horas de conversas empolgantes nos aguardam.";
	["238a2b47174a11ea80963c15c2dd513c"] = "Vamos reencontrar Alva... Tenho certeza disso!";
	};
["CH_RobDaniel_ch6.sq"]={
	["238ca526174a11ea83233c15c2dd513c"] = "J... John! Sam!\n{====}Esse é o t... t... trem mais e... e... esquisito que eu já vi!\n{====}Mas se a gente q... q... quiser ter uma chance de sair desse n... n... nevoeiro,\n{====}é melhor e... e... encontrar algo útil por aqui.";
	["238ca791174a11eab9053c15c2dd513c"] = "F... f... filmes? Vocês vão atuar e... e... em filmes?\n{====}Ah, isso p... p... parece d... d... divertido...\n{====}Eu adoraria i... i... ir com vocês, mas tenho que esperar o W... W... William.";
	["238ca90c174a11ea96a43c15c2dd513c"] = "E... e... ele está conversando com um m... m... macaco naquela c... c... cabine.";
	["238cab7a174a11eaa4a53c15c2dd513c"] = "Já faz um b... b... bom tempo que o W... W... William está lá dentro.\n{====}Fico me p... p... perguntando sobre o que e... e... eles estão falando, ele e o t... t... tal macaco.";
