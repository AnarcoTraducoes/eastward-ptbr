["MonkeyHuman06.sq"]={
	["2390130a174a11ea9a173c15c2dd513c"] = "{~}Robô-babá! Oh, ROBÔ-BABÁ!\n{==}Mostre-se, seu monte maldito de {~}material reciclável!";
	["2390165c174a11eabb023c15c2dd513c"] = "J... Jovem mestre... Precisa dos meus serviços?\n{==}A inspeção já terminou.";
	["2390179c174a11eabf2b3c15c2dd513c"] = "{~}Tanto faz!\n{====}Você tem que ligar a fábrica imediatamente!";
	["2390197d174a11eab86b3c15c2dd513c"] = "{<}Mas então... você pretende mesmo ir até o fim?\n{====}{|}Não queria libertá-los?";
	["23901a80174a11ea87873c15c2dd513c"] = "{<}Como? Eu ouvi direito?{signal:anim}\n{====}Você tá tentando me dizer...\n{|}o que eu devo fazer{|}?";
	["23901b8c174a11ea93443c15c2dd513c"] = "J... J... Eu jamais me atreveria!";
	["23901d26174a11ea8bee3c15c2dd513c"] = "Não me diga que sente algo por essas bestas imundas?";
	["23901f57174a11eab9133c15c2dd513c"] = "J... Jovem mestre!\n{====}É verdade que eles são meio agitados às vezes...\n{====}mas são só macacos, no fim das contas!\n{====}Não faça mal a eles, por favor. São meus filhos...";
	["239020e8174a11eaadc73c15c2dd513c"] = "{~}Cala a boca, idiota!";
	["23902445174a11eaa1f83c15c2dd513c"] = "Vou colocar suas prioridades em ordem!";
	["2390264c174a11ea84933c15c2dd513c"] = "Reiniciando sistema...";
	["23902907174a11eaa8e23c15c2dd513c"] = "Comandante Salomon! Quais são suas ordens?";
	["23902afd174a11ea94193c15c2dd513c"] = "Hoho. Assim tá melhor.";
	["23902d40174a11eab6993c15c2dd513c"] = "Estamos prontos, chefe!";
	["23902fb5174a11ea8c333c15c2dd513c"] = "{~}Chefe? Como assim chefe?\n{====}Eu sou seu COMANDANTE, cambada de babuínos sem cérebro!";
	["23903205174a11eabfda3c15c2dd513c"] = "Chego em um minuto!";
	["23903519174a11ea8d0e3c15c2dd513c"] = "{~}Meus bravos servos!";
	["239036e6174a11eaba973c15c2dd513c"] = "A hora chegou!\n{====}A fábrica iniciou suas operações.\n{====}A gloriosa colheita do MIASMA pode começar.\n{====}Mas primeiro...\n{====}quero que capturem aquela bruxa de cabelo branco!";
	["239039a1174a11ea91d23c15c2dd513c"] = "A seus ordens, chefe!\n{>}Na verdade, comandante!\n{====}{|}Ehm... e os outros, o que fazemos?";
	["23903c68174a11ea9d363c15c2dd513c"] = "Os outros?\nVocês tão falando dos macacos?\n{====}CATUREM-OS TAMBÉM!\n{====}Capturem todos! Não quero mais ver ninguém livre!\n{====}Dêem uma lição que eles nunca vão esquecer!\n{====}{box-size:small}Quero ver se continuam filmando seus porcarias depois disso! Hohoho!";
	["23905087174a11ea80013c15c2dd513c"] = "As... porcarias deles, chefe?";
	["2390537d174a11eaad1b3c15c2dd513c"] = "{~}Cala a boca!\n{====}{~}O que ainda tão fazendo aí? Pro trabalho!";
	["239057a1174a11ea94013c15c2dd513c"] = "Imediatamente, comandante!";
	["d25bae23256111eabfce3c15c2dd513c"] = "Esta sala...";
	["d25bd938256111ea9d883c15c2dd513c"] = "Ela deve estar lá dentro!";
	["d25bddeb256111eab9c13c15c2dd513c"] = "Mamãe! Você tá aí!";
	["d25be023256111eaadd63c15c2dd513c"] = "Identificação da alvo...\n{====}Mãe. Bem-vinda, Mãe...";
	["d25be359256111eaaac83c15c2dd513c"] = "Lendo mensagem.\n{====}{~}Oi, meus baratas!\n{====}Não achei que chegariam até aqui...\n{====}Embora... tenha deixado essa mensagem pra vocês. Mouhahaha!\n{====}Enfim. Se querem saber onde está Isabel...{stop}";
	["d25becb8256111eab0c53c15c2dd513c"] = "{~}Isabel!{stop}";
	["d25bf33d256111ea94263c15c2dd513c"] = "Sim... Vocês certamente acabaram de gritar o nome dela.\n{====}Pois bem, se querem mesmo saber onde ela está, vão pro último vagão deste trem!\n{====}Preparei uma... pequena surpresa pra vocês. Héhéhéhé!";
	["d25c4863256111ea924b3c15c2dd513c"] = "Ei! Onde está Isabel?\n{====}Diz onde ela tá!";
	["d25c4e73256111ea9dc43c15c2dd513c"] = "Pesquisa: Isabel...\n{====}Dados insuficientes.\nDados insuficientes.";
	["d25c5099256111ea9cea3c15c2dd513c"] = "John! Temos que ir pra esse vagão, e rápido!";
	};
