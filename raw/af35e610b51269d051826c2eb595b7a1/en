	["e97a3ef46e8111ea806f3c15c2dd513c"] = "Uh uh! HIII! Excelente.\n{====}Talvez a gente acabe fazendo de você uma verdadeira estrela.";
	["739e9be0b15111eab16e3c15c2dd513c"] = "Ah é? Hmph.\n{====}Não comece a descansar sobre os louros. Uh uh!\n{====}De qualquer forma, esse papel logo será meu.";
