["Cabin_Ch6.sq"]={
	["23a1aad1174a11ea83273c15c2dd513c"] = "Simples colisão. Essas coisas acontecem!\n{====}{big}Que tal embarcar no outro veículo pra tentar descobrir mais?\n{====}Quem sabe, não estamos imunes a uma boa surpresa!";
	["23a1d5fd174a11eabb183c15c2dd513c"] = "E-eu a-acho que o choque quebrou os f-freios.\n{====}Mas se me lembro b-bem, talvez tenha o que precisa pra consertar.";
	["d2675bfa256111ea83433c15c2dd513c"] = "E-eu c-cuido dos r-reparos!";
	["d2675d30256111eab2693c15c2dd513c"] = "É p-perfeito!\n{====}E os f-freios estão funcionando também.";
	["0ab8c89eb0c511ea96e23c15c2dd513c"] = "Sempre tão eficiente, meu parceiro robótico.";
	["d2675e99256111eaa2493c15c2dd513c"] = "Foi mais fácil que p-previsto.\n{====}Mas esse f-foguete é realmente estranho.\n{====}Mesmo com m-motor rudimentar,\n{====}ele tem três s-s-sistemas de evacuação de emergência!";
	["0ab8cb0ab0c511ea96e23c15c2dd513c"] = "{big}Impressionante... Acho que o criador dele devia gostar muito do piloto.";
	["0ab8ccaeb0c511ea96e23c15c2dd513c"] = "Enfim...";
	["0ab8cdb2b0c511ea96e23c15c2dd513c"] = "Parece que estamos «prontos pro lançamento», como se diz.";
	["aa6338d2309211eb84b63c15c2dd513c"] = "Tem certeza que o foguete funciona?\n{====}Não sinto diferença nenhuma.";
	["aa633c10309211eb84b63c15c2dd513c"] = "E-ele c-consome muito c-combustível.\n{====}Então só vou ligar no m-momento certo.";
	["aa633d32309211eb84b63c15c2dd513c"] = "Boa sacada, Daniel!\n{====}Nesse caso, só resta esperar nosso terrível adversário.";
	["aa634160309211eb84b63c15c2dd513c"] = "Lá vem!\n{==}A n-n-névoa!";
	["aa6342b4309211eb84b63c15c2dd513c"] = "Nosso velho amigo é pontual, pelo jeito.";
	["aa63449e309211eb84b63c15c2dd513c"] = "Daniel! {~}Prepare-se pro combate!";
	["23a27a17174a11ea91133c15c2dd513c"] = "{~}C-como ordenado!{.}\nA-a-acelerando!";
	["23a27d42174a11eaae683c15c2dd513c"] = "Potência: 50%. {.}70%. {.}90%.{..}\n{signal:TrainFastCamera}V-V-VEL OCIDADE MÁXIMA!";
	["23a282d7174a11eaa3873c15c2dd513c"] = "Ele tá nos alcançando!";
	["aa63470a309211eb84b63c15c2dd513c"] = "Ativando os p-p-{~}propulsores do foguete!";
	["23a2a807174a11ea83933c15c2dd513c"] = "Ele tá ganhando terreno!\n{====}Mais rápido! Temos que ir mais rápido!";
	["23a2cfb8174a11ea9c0d3c15c2dd513c"] = "O s-sistema de refrigeração não dá conta!\n{====}O motor v-vai falhar!";
	["23a30423174a11eab72b3c15c2dd513c"] = "{~}Droga!\n{==}Se eu tivesse minha peça velha...";
	["23a382fa174a11eabf593c15c2dd513c"] = "{~}A t-t-temperatura estabilizou!";
	["23a3b4fa174a11ea80ff3c15c2dd513c"] = "O q-que aconteceu?";
	["23a3bcab174a11ea95883c15c2dd513c"] = "{~}Não faz pergunta! Só vai o mais rápido que puder!";
	["aa634962309211eb84b63c15c2dd513c"] = "E-eu a-acho que despistamos ele.";
	["aa634cdc309211eb84b63c15c2dd513c"] = "Ótimo, parece que conseguimos.\n{====}Nesse ritmo, chegamos rápido em Éternia.";
	};
["LivingArea.sq"]={
	["237ef4cf174a11eaa2033c15c2dd513c"] = "Então, tá pronto? OUH OUH!";
	["237ef661174a11eabfb33c15c2dd513c"] = "Quase, quase! Chrrr!";
	["237ef7a8174a11eaaed93c15c2dd513c"] = "E-eu... eu NÃO POSSO! Só um segundo! Ouh ouh!";
	["237ef899174a11eaa0923c15c2dd513c"] = "Não é possível...\n{====}Nesse ritmo, você vai perder toda a gravação. Ouh ouh!";
	["237efb4c174a11ea975f3c15c2dd513c"] = "Algum problema?";
	["237efef8174a11ea85c23c15c2dd513c"] = "Rotondo se trancou no banheiro. Hiiii!\n{====}E a gente tem que gravar uma cena muito importante hoje.\n{====}Ele faz isso toda vez. Desmorona sob pressão! Ouh ouh!";
	["237f0182174a11eaaf123c15c2dd513c"] = "{~}Cala a boca!\n{====}É... É uma reação fisiológica! Não dá pra evitar! OUH OUH!";
	["237f0a68174a11eaba5c3c15c2dd513c"] = "Me deixem em paz! CHRRR!\n{====}Eu tô REALMENTE de mau humor!";
	["e95fa2106e8111ea806f3c15c2dd513c"] = "Se continuar assim, ele vai perder a tomada de verdade. Ouh ouh!";
	["237ef138174a11ea8c733c15c2dd513c"] = "Ainda com defeito. Ouh ouh!\n{====}Pelos vermelhos...\n{====}Aposto que é aquele maldito Arguto perdendo pelo de novo! Ouh ouh!";
	["237f1938174a11eaa5383c15c2dd513c"] = "Desculpa, realmente não posso fazer nada.\n{====}Você tem que falar com o produtor! Ouh ouh!";
	["237f1a80174a11eab7bd3c15c2dd513c"] = "Vamos, pra que complicar?\n{====}Pode ser nosso segredinho, não?\n{====}Um pouco de dinheiro por umas cópias... sem ninguém ver.";
	["237f1b35174a11eab79a3c15c2dd513c"] = "Não é não, entendeu? Chrrr!";
	["237f1c07174a11eaa33f3c15c2dd513c"] = "O vagão de efeitos especiais? Fica mais adiante à direita do trem. Ouh ouh!";
	["237f1cc7174a11eab2813c15c2dd513c"] = "Ah, John! Olha isso.\n{====}Esses arquivos tão cheios de filmes raros.\n{====}Eu poderia conseguir um preço excelente quando voltar pra civilização.";
	["237f1f59174a11ea99103c15c2dd513c"] = "Você de novo? Ouh ouh!\n{====}Dizem que você realmente conquistou o diretor.\n{====}Diferente do Rotondo...\n{====}O coitado se trancou no banheiro de novo. Hiiii!";
	["237f2145174a11ea990c3c15c2dd513c"] = "Me deixa em paz! HIIII!\n{====}Eu sei que ele me odeia!\n{====}Já que me acha preguiçoso, vou provar que tem razão! OUH OUH!";
	["237f244f174a11ea90a53c15c2dd513c"] = "Se não é nossa nova estrela!\n{====}{big}Por que tá perdendo tempo falando com um fracassado como eu? OUH OUH!";
	["237f25c2174a11eabc8c3c15c2dd513c"] = "Francamente, não achei que vocês conseguiriam. Hiiii!";
	["237f2d2e174a11ea93933c15c2dd513c"] = "{~}John!\n{====}Acorda, John! Levanta!";
	["237f2e1e174a11eaac993c15c2dd513c"] = "Tá acontecendo algo lá fora!\n{====}Vem, vamos ver!";
	["237f3007174a11eaaf2c3c15c2dd513c"] = "Todo mundo já tá lá.";
	["237f31ae174a11ea86cf3c15c2dd513c"] = "John!\n{====}Não é por aí! Eles tão reunidos na base da escada!";
	["237f33f0174a11ea871e3c15c2dd513c"] = "Ouh ouh! Talvez sejam humanos, mas não fizeram nada de errado.\n{====}É nosso dever protegê-los! Hiiii!";
	["237f354f174a11eaa6e13c15c2dd513c"] = "E desobedecer uma ordem direta do jovem mestre? Impossível!";
	["237f362b174a11ea88023c15c2dd513c"] = "Eles tão lá. Chrrr!";
	["237f377d174a11eaae933c15c2dd513c"] = "Aí estão vocês!\n{====}Nosso chefe... Não, nosso COMANDANTE quer falar com vocês! HIIII!";
	["237f394a174a11ea819e3c15c2dd513c"] = "{~}Favoloso!";
	["237f3a4c174a11ea96ae3c15c2dd513c"] = "{<}Hein? Nós?";
	["237f3cd7174a11eaa6dc3c15c2dd513c"] = "{~}É eles!";
	["237f3e40174a11eaab713c15c2dd513c"] = "{~}Eles tão aqui! Hiii!";
	["237f4200174a11eab75a3c15c2dd513c"] = "{~}Peguem eles!";
	["0abe28deb0c511ea96e23c15c2dd513c"] = "Ouh ouh! Dessa vez a gente escapou por pouco da catástrofe.\n{====}{big}Sem vocês, nem quero imaginar como isso terminaria.\n{====}{big}E ainda assim, tenho medo de não poder fazer nada por vocês em troca... Hiiii!";
	["0abe2ae6b0c511ea96e23c15c2dd513c"] = "Vocês não viram Isabel, então?";
	["0abe2d8eb0c511ea96e23c15c2dd513c"] = "Isabel? Isabel...\n{====}Agora que pensei, já ouvi esse nome... Ouh ouh!";
	["0abe2f5ab0c511ea96e23c15c2dd513c"] = "Eu sei! É a Cavaleira do Foguete!";
	["0abe2fd2b0c511ea96e23c15c2dd513c"] = "{~}Ouh ouh! HIIII! Sério? Hoho! É ela que vocês procuram?";
	["0abe302cb0c511ea96e23c15c2dd513c"] = "Vocês a conheceram, então?";
	["0abe3090b0c511ea96e23c15c2dd513c"] = "Foi bem antes de eu virar atriz. Antes de nascer, até.\n{====}Só vi o nome dela em roteiros velhos.";
	["0abe30d6b0c511ea96e23c15c2dd513c"] = "Só a Bella mesmo pra lembrar desses detalhes.\n{====}Talento puro!";
	["0abe3112b0c511ea96e23c15c2dd513c"] = "Ah, sim... Agora me lembro. Ouh ouh!\n{====}Foi há muito tempo, quando eu fazia meus primeiros papéis como estrela.\n{====}O foguete dela colidiu com nosso trem.\n{====}Um pouco como vocês fizeram com a nave de vocês, aliás.\n{====}Mas por que tão procurando ela, hmm? Hiiii!";
	["0abe316cb0c511ea96e23c15c2dd513c"] = "Mas... não é possível.\n{====}Ela saiu de New Dam há só alguns dias.";
	["0abe32a2b0c511ea96e23c15c2dd513c"] = "É bem possível,\nal contrário.\n{====}{big}O tempo passa... diferente nessa névoa. De forma totalmente imprevisível.\n{====}Uma hora aqui pode ser um minuto no mundo lá fora,\n{====}ou um ano inteiro!";
	["0abe3388b0c511ea96e23c15c2dd513c"] = "Que droga... Mas então, onde tá Isabel agora?";
	["0abe3400b0c511ea96e23c15c2dd513c"] = "Ouh ouh! Se não me engano, ela não ficou muito...\n{====}Não, ela foi embora quase imediatamente. Hiiii!";
	["0abe350eb0c511ea96e23c15c2dd513c"] = "Ela deixou o foguete aqui, né?";
	["0abe3590b0c511ea96e23c15c2dd513c"] = "Hoho! Exato!\n{====}Mas ONDE, essa é a questão... Ouh ouh!";
	["0abe369eb0c511ea96e23c15c2dd513c"] = "Por que não perguntar pro jovem mestre?\n{====}Lembro que ele se interessou bastante por ela.";
	["0abe37e8b0c511ea96e23c15c2dd513c"] = "Ele tá na frente da TV com os outros humanos.\n{====}Não custa tentar.";
	["0abe39c8b0c511ea96e23c15c2dd513c"] = "John!";
	["0abe3aa4b0c511ea96e23c15c2dd513c"] = "As TVs ficam do outro lado,\nesqueceu?";
