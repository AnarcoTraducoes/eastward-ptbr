["PropRoom.sq"]={
	["e968cd686e8111ea806f3c15c2dd513c"] = "Uau! Olha só isso!\n{====}Deve ser o vagão de armazenamento!";
	["e968cf526e8111ea806f3c15c2dd513c"] = "E isso... é o castelo de Solomon?";
	["7387fcaab15111eab16e3c15c2dd513c"] = "Uh uh. HIIII! Ah, são vocês.\n{====}Não toquem em nada! Tem várias coisas frágeis aqui!";
	["7387ff0cb15111eab16e3c15c2dd513c"] = "O diretor disse que poderíamos encontrar o foguete do cavaleiro aqui.";
	["73880268b15111eab16e3c15c2dd513c"] = "Sério? HIIII! O quê, vocês precisam dele, é isso?";
	["7388038ab15111eab16e3c15c2dd513c"] = "E como! Vamos usá-lo pra ir até Éternia!";
	["738806dcb15111eab16e3c15c2dd513c"] = "{big}Hohoho. Nunca vi fãs tão empolgados em toda a minha vida.\n{====}UH UH! Esperem aqui um minuto, tá bem?";
	["738809fcb15111eab16e3c15c2dd513c"] = "Aí está!{~}";
	["73880c7cb15111eab16e3c15c2dd513c"] = "Uau! É ela! É mesmo ela!";
	["73880d12b15111eab16e3c15c2dd513c"] = "Vamos poder ir pra Éternia, John!";
	["73880e34b15111eab16e3c15c2dd513c"] = "Uma bela coleção de tesouros, não é?";
	["73880f42b15111eab16e3c15c2dd513c"] = "William! Daniel!\n{====}Achamos! Encontramos o foguete!";
	["73881118b15111eab16e3c15c2dd513c"] = "O f... foguete? Mas isso é só um p... pedaço de papelão.";
	["e968d6966e8111ea806f3c15c2dd513c"] = "O que vocês esperavam? HIIIII!\n{====}“Cinco pés de altura, dois pés de largura, uma fuselagem vermelha e uma base xadrez...”\n{====}“Esse foguete movido a coragem é guiado pela justiça!”\n{====}Posso até colocar umas chamas atrás, se quiserem! UH UH!";
	["e968d7546e8111ea806f3c15c2dd513c"] = "Mas... ele podia voar pelo céu, não é?";
	["e968d97a6e8111ea806f3c15c2dd513c"] = "Claro. E vocês também! HIIII!\n{====}Querem tentar?\n{====}{big}Pendurem-no num cabo e poderão voar de uma ponta à outra do vagão!\n{====}O auge dos efeitos especiais à moda antiga. UH UH!";
	["7388121cb15111eab16e3c15c2dd513c"] = "Acho que vamos ter que encontrar outra solução...";
	["0f45b31cabd511ea8f943c15c2dd513c"] = "Uh uh! CHRRR! Esse é o vagão do jovem mestre.\n{====}Ninguém tem permissão pra entrar!";
	["5f586f2eb13511ea9dc73c15c2dd513c"] = "Essa máquina é meio... Hmm...\n{====}Digamos apenas que a pequena Sam é melhor esperar lá fora.";
	["5f58708cb13511ea9dc73c15c2dd513c"] = "Fico me p... perguntando o que tem aí dentro...\n{====}William me p... p... proibiu de entrar.";
	["6981289af80911eaac1b3c15c2dd513c"] = "Se ao menos pudéssemos encontrar esse f... foguete...\n{====}Não seria difícil despistar esse t... t... trem fantasma.";
	["69812a2af80911eaac1b3c15c2dd513c"] = "A Sam parece ter mais ou menos a mesma idade do Daniel.";
	["69812b6af80911eaac1b3c15c2dd513c"] = "Não me diga que você também adotou?";
	["69812c5af80911eaac1b3c15c2dd513c"] = "Vamos ter que encontrar outra coisa.";
	["e968df066e8111ea806f3c15c2dd513c"] = "John!{stop}";
	["e968e03c6e8111ea806f3c15c2dd513c"] = "{~}Temos dois fugitivos!";
	["e968e1ae6e8111ea806f3c15c2dd513c"] = "John! Por aqui!";
	["e968e3526e8111ea806f3c15c2dd513c"] = "Eles devem ter fugido em direção à fábrica!";
	["e968e3d46e8111ea806f3c15c2dd513c"] = "{~}Alcancem-nos!";
	["e968e4f66e8111ea806f3c15c2dd513c"] = "Pronto, eles se foram.";
	["e968e5b46e8111ea806f3c15c2dd513c"] = "Mais uma atuação notável, John!{stop}";
	["e968e7e46e8111ea806f3c15c2dd513c"] = "Vi minha vida passar diante dos meus olhos dessa vez. Hiiii!\n{====}Mas ainda não estamos fora de perigo...";
	["e968e8ca6e8111ea806f3c15c2dd513c"] = "Você não poderia...{stop}";
	["e968e9566e8111ea806f3c15c2dd513c"] = "Não se preocupe! Vamos dar um jeito nisso!";
	["e968e9ce6e8111ea806f3c15c2dd513c"] = "Agora é hora de um herói assumir o controle!";
	["e968ea5a6e8111ea806f3c15c2dd513c"] = "John!";
	["e968ed486e8111ea806f3c15c2dd513c"] = "Você não está esquecendo de algo?";
	["e968f04a6e8111ea806f3c15c2dd513c"] = "A... A... Aqui estão suas armas.\n{====}Não se preocupe. Está tudo aí, a... até as munições.";
	["e968f11c6e8111ea806f3c15c2dd513c"] = "Eu até en... en... encontrei um pouco mais que estavam por aí.\n{====}Espero que seja ú... ú... útil pra vocês.";
	["e968f18a6e8111ea806f3c15c2dd513c"] = "Um momento! UH UH!\n{====}Não posso deixar vocês partirem... sem ISSO!";
	["e968f36a6e8111ea806f3c15c2dd513c"] = "Usávamos essa máquina infernal nas nossas filmagens.\n{====}Mas ela acabou se mostrando perigosa demais pro meu gosto,\n{====}{big}o que a torna o acessório perfeito pra um cavaleiro valente como você!\n{====}Sejam implacáveis, tesouros!";
	["0f45b934abd511ea8f943c15c2dd513c"] = "Que arma estranha!\n{====}Quando terminarmos aqui, preciso examiná-la mais de perto.";
	["0f45bb46abd511ea8f943c15c2dd513c"] = "Sejam c... c... cuidadosos, certo?\n{====}Quem sabe que tipo de m... m... monstros estão esperando?";
	["0f45be16abd511ea8f943c15c2dd513c"] = "Não, não. O vagão do jovem mestre fica do OUTRO lado.";
	["6981304cf80911eaac1b3c15c2dd513c"] = "Crianças não têm permissão pra entrar!";
	};
["Bazar_Ch6.sq"]={
	["4a2895e1287611eabb143c15c2dd513c"] = "Você tem que nos aceitar de volta, Pa!";
	["4a28c5c5287611ea84a23c15c2dd513c"] = "{~}Pa!";
	["4a28c842287611eaab993c15c2dd513c"] = "{<}Pa...{stop}";
	["4a28e14f287611eaa5f43c15c2dd513c"] = "{<}Tá ouvindo a gente?";
	["4a28ecd4287611eaa7fa3c15c2dd513c"] = "{<}Vocês dois...";
	["4a29014c287611eaa6633c15c2dd513c"] = "{~}Voltem pro trabalho! E EM RITMO RÁPIDO!";
	["4a2907f0287611ea81f73c15c2dd513c"] = "A gente nunca mais vai te decepcionar!\nA gente... A gente...";
	["4a291270287611eaae033c15c2dd513c"] = "Peraí... Pro trabalho...?";
	["4a291b00287611eaace43c15c2dd513c"] = "P... Pa perdoou a gente!";
	["4a293d57287611ea98763c15c2dd513c"] = "{~}Você... Você tá falando sério, Pa?";
	["4a2979a6287611eab5b23c15c2dd513c"] = "{~}{big}Não fiquem aí parados, boquiabertos que nem dois idiotas!\n{~~}Eu disse PRO TRABALHO, seus ingratos!";
	["4a297abd287611ea8aa23c15c2dd513c"] = "Já indo, chefe!";
	["4a298c51287611ea8ede3c15c2dd513c"] = "Já indo, chefe!";
	["4a29b9b5287611eaa1f23c15c2dd513c"] = "Devo estar ficando velho...\n{====}{big}Antigamente, eu teria picado os dois por terem tido a audácia de me deixar na mão assim!";
	["4a29cb7d287611eaaee23c15c2dd513c"] = "Ah, mas é o John!\n{====}Eu te devo um grande favor por ontem à noite!";
	["4a29cd3d287611eab7783c15c2dd513c"] = "Hã? Você tá indo pra... pra {~}Éternia?!\n{====}{<}Você sabe o que dizem sobre essa cidade...";
	["4a2a243a287611ea8b603c15c2dd513c"] = "Meu velho falava muito sobre ela.\n{====}As pessoas de lá nunca envelhecem.\n{====}Não conhecem nem doença nem morte!\n{====}Mas pra chegar lá, tem que atravessar uma névoa impenetrável...\n{====}e um tipo de troço espaço-temporal...\n{====}Enfim, os detalhes técnicos me escapam.\n{====}Mas o que eu sei...";
	["4a2abe73287611ea859f3c15c2dd513c"] = "É que vocês vão ter que seguir pela linha principal.\n{====}A Isabel não tem problema com isso, com o foguete dela, mas vocês?";
	["4a2ac091287611eab9813c15c2dd513c"] = "{~}Um segundo!\n{====}Aqueles dois palhaços que moram na Tayama!\n{====}Parece que eles têm o próprio trem!\n{====}Mas eles são meio... Hmm...\n{====}Digamos que não têm a melhor das reputações.";
	["4a2ac36b287611ea85773c15c2dd513c"] = "Aqueles dois malucos da Tayama têm um trem.\n{====}Mas cuidado! Eles seriam capazes de te vender as cinzas da própria avó!";
	["4a2ac5c2287611eabd413c15c2dd513c"] = "Mas que bagunça!\n{====}É simples, vamos levar o DIA INTEIRO pra colocar tudo em ordem!";
	["4a2ac735287611ea8ca23c15c2dd513c"] = "John!";
	["4a2ac963287611ea9fef3c15c2dd513c"] = "É o nosso velho amigo John!\n{====}Ouviram isso? Vamos fazer tudo direito desta vez!\n{====}Vamos ficar com o Pa!";
	["4a2acca3287611ea97e33c15c2dd513c"] = "Com o Pa!";
	["4a2ad02e287611eaace63c15c2dd513c"] = "{~}Não é possível...\n{====}Vocês... Vocês estão deixando New Dam?\n{====}Nem precisam me explicar...\n{====}{big}Deve ser algo bem importante pra vocês partirem assim.";
	["4a2aebd7287611eabfbb3c15c2dd513c"] = "Vamos sentir falta de vocês!";
	["4a2af7c2287611eaadaa3c15c2dd513c"] = "Mas não se preocupem!\n{====}Com a gente aqui, New Dam está em boas mãos!";
	["4a2b0280287611eab29c3c15c2dd513c"] = "Eu tinha certeza de que o Pa ia dar uma boa bronca na gente.\n{====}Não achei que sairíamos tão bem assim.";
	["4a2b1aa3287611eab2a03c15c2dd513c"] = "Parece que a gente é MESMO indispensável, afinal!\n{====}E agora vamos dar o nosso máximo!";
	["4a2b1bba287611ea93f23c15c2dd513c"] = "Nunca tinha reparado nessa estátua de Jizô.\n{====}Tenho certeza de que ela não estava aqui antes.";
	["4a2be235287611ea81823c15c2dd513c"] = "Não quer repensar sua posição, amigo?\n{====}Eu... Eu posso fazer qualquer coisa, juro! Palavra de escoteiro!";
	["4a2c1ede287611eabe833c15c2dd513c"] = "Senta-se antes que se machuque, velhote!\n{====}Esse trabalho é perigoso demais pra você!";
	["4a2c6d45287611ea87893c15c2dd513c"] = "{big}Gui. Esse homem ainda não completou\n100 anos desde a data de fabricação.\n{====}Ele é realmente tão velho assim?";
	["4a2cd3c5287611ea96c63c15c2dd513c"] = "A gente não é como você, Batata!\n{====}Os humanos têm sorte de ainda estarem vivos com essa idade!";
	["4a2ce121287611eab3583c15c2dd513c"] = "Os humanos são tão... frágeis.";
	["4a2da5f8287611ea8af33c15c2dd513c"] = "Droga...\n{====}Até o Ned conseguiu um emprego antes de mim!\n{====}E aquele monte de parafusos tem trinta anos a mais que eu.\n{====}É tão fácil pra eles. Vivem muito e nunca sentem fome...\n{====}Quero ser um robô na minha próxima vida!";
	["4a2db65e287611ea96533c15c2dd513c"] = "Os humanos são tão... frágeis.";
	["4a2dea87287611ea8fde3c15c2dd513c"] = "Olha, me parte o coração dispensar ele, mas...\n{====}ele vai acabar se matando se tentar trabalhar com a gente.";
	};
["OldHouse_Inner_Ch6.sq"]={
	["2380e38a174a11eaad293c15c2dd513c"] = "{<}Todo mundo... sumiu...";
	["2380e6c0174a11ea9fc23c15c2dd513c"] = "Sobraram apenas...{wait:0.5}\n nós.";
	["44af908caa3f11ea8cfc3c15c2dd513c"] = "Eu me lembro...\n{====}Eu me lembro do meu passado, John. Do dia... em que você me encontrou.\n{====}E... de Greenberg.\n{====}Eu... Eu tomei minha decisão!";
	["44af938eaa3f11ea8cfc3c15c2dd513c"] = "Eu preciso ir pra Éternia.";
	["44af94ceaa3f11ea8cfc3c15c2dd513c"] = "{big}É lá que tudo começou... e é lá que tudo tem que acabar.\n{====}Eu vou pra lá... e vou dar um fim nisso tudo.";
	["44af9762aa3f11ea8cfc3c15c2dd513c"] = "Você me ajuda, John?\n{====}A gente tem que achar um jeito de ir pra Éternia!";
	["2380f173174a11eab9023c15c2dd513c"] = "{<}Éternia...\n{====}{|}Eu ouvi meu avô falar dela uma vez...";
	["2380f302174a11ea8a3f3c15c2dd513c"] = "Como ela é?\n{====}Minha dona disse que os prédios lá são todos de vidro.\n{====}E que as ruas são azuis como... como a água!\n{====}E que quando as pessoas ficam doentes,\n{====}elas saram num instante!";
	["2380f40f174a11ea9d4a3c15c2dd513c"] = "Parece incrível...";
	["2380f50a174a11eab5af3c15c2dd513c"] = "É só uma velha lenda, nada mais.";
	["2380f64a174a11eab8bd3c15c2dd513c"] = "Ela só dá falsas esperanças pras pessoas.\n{====}Vocês nunca vão encontrar alguém que tenha ido lá de verdade.";
	["2380f775174a11ea80d13c15c2dd513c"] = "John!";
	["2380f897174a11ea8ef13c15c2dd513c"] = "Você já ouviu falar de Éternia, né?";
	["2380fa82174a11ea87863c15c2dd513c"] = "Hmm? Tem algum problema?";
	["2380fcdc174a11eaba343c15c2dd513c"] = "{<}Eu... Eu...";
	["2380fe4c174a11eab5e03c15c2dd513c"] = "O creme de sobremesa!\n{====}Eu saqueei a geladeira ontem e comi.";
	["2380ff47174a11eab6b23c15c2dd513c"] = "{~}Nããão!";
	["23810107174a11eaac9e3c15c2dd513c"] = "Eu tinha guardado ela!";
	["2381023d174a11eaa3233c15c2dd513c"] = "Meu creme de sobremesa...";
	["23810319174a11eab6133c15c2dd513c"] = "Desculpa...{stop}";
