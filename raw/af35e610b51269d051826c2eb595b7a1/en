	["238bafe8174a11eaa94b3c15c2dd513c"] = "Pesquisando Isabel...\n{====}Nenhum resultado.\n{====}Última posição conhecida: Leste. Leste. Leste...";
	["238bb20f174a11ea80ff3c15c2dd513c"] = "{choice:east}Leste?";
