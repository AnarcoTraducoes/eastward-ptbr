	["23894f28174a11eab2af3c15c2dd513c"] = "Vocês...{stop}";
	["238951b5174a11eab2f83c15c2dd513c"] = "Vocês são... macacos, não é ?";
	["23895378174a11eabac83c15c2dd513c"] = "Macacos ? Claro que não ! Somos humanos !";
