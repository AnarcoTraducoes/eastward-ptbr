["Studio.sq"]={
	["238e0be6174a11ea96f23c15c2dd513c"] = "Chega, vocês dois. Não é hora de brigar!\n{====}O exército das bonecas já está na cidade!";
	["238e0efd174a11eaafa53c15c2dd513c"] = "{~}Droga e maldição!{stop}";
	["238e10c0174a11ea98893c15c2dd513c"] = "Se eu ainda tivesse meu Bourrepif 5000!";
	["238e12f8174a11eaaeab3c15c2dd513c"] = "Essa lata de sardinha? Que piada!\n{====}Tudo que esse treco velho sabe fazer é quebrar!";
	["238e155c174a11eaaed43c15c2dd513c"] = "{~}{<}Q... Q-que foi que você disse?\n{====}{|}Você ousa criticar meu Bourrepif 5000?!";
	["238e179e174a11ea907c3c15c2dd513c"] = "{<}Eu disse e repito!\n{====}Esse monte de sucata só serve pro ferro-velho, nada mais!";
	["238e194c174a11eaa62e3c15c2dd513c"] = "{}{>}CORTAAAAA!{|}{.}{stop}";
	["238e1be1174a11ea96c73c15c2dd513c"] = "{~}Vocês são todos RUINS! OUH OUH!\n{====}Não dá pra acreditar {~}DE JEITO NENHUM!\n{==}É MOLE!\n{==}Quero que VIBRE! Que QUEIME! HIIII!\n{==}Vocês não entendem NADA de cinema, cambada de pulgas!\n{==}NADA DE NADA! GRRRR!";
	["238e1dde174a11ea91323c15c2dd513c"] = "Beuuh... Do que ele tá falando?\n{====}Entendeu alguma coisa, Denaro?";
	["238e21d1174a11ea814d3c15c2dd513c"] = "Que vibre, que queime...\n{====}{big}Talvez ele queira que você faça {<}tremer{|} a cena, antes de botar {~}fogo?\n{====}KikiKIIII!";
	["238e243d174a11ea86bf3c15c2dd513c"] = "Você acha que esse retardado pode entender o que você tá dizendo?\n{====}Com ele, evita palavras com mais de três letras! Ouh ouh!";
	["238e269c174a11ea892f3c15c2dd513c"] = "É! Nada de mais de três letras! ...{stop}";
	["238e28c2174a11ea8c943c15c2dd513c"] = "Ei, um momento! Grrrr!";
	["238e2d2e174a11eaacea3c15c2dd513c"] = "{~}SILÊNCIO NO SET!\n{====}Vamos refazer tudo do zero! HIIII!";
	["238e2f4a174a11eaa8d63c15c2dd513c"] = "E ONDE está Rotondo?\n{====}É bom que traga logo seu lindo rabinho...\n{====}antes que eu perca a cabeça DE VERDADE! HIIII!";
	["238e30e6174a11eabc4a3c15c2dd513c"] = "Se não chegar em um minuto, tá fora. {signal:foot}{~}FORA! HIIII!";
	["e96a43d26e8111ea806f3c15c2dd513c"] = "{}O QUE É ISSO QUE EU VEJO!{break}";
	["e96a46026e8111ea806f3c15c2dd513c"] = "{~}Sim, sim, {.}{~}SIM! HIIII!\n{====}Esses ombros quadrados...\n{.}Esse ar atônito!{.}\n{====}{>}Essas palmas tão ásperas quanto pedra bruta.\n{==}Essa barba desgrenhada parecendo arbusto seco.\n{==}{|}Você... Você é tudo o que procuro num homem.\n{====}Me diz, querido... Já sonhou em virar uma ESTRELA? OUH OUH!";
	["e96a472e6e8111ea806f3c15c2dd513c"] = "Hã... A gente só tá procurando um foguete, na verdade.{break}";
	["e96a486e6e8111ea806f3c15c2dd513c"] = "{big}Eu sou o diretor dessa equipe.\nE vocês são...?";
	["e96a49a46e8111ea806f3c15c2dd513c"] = "Meu nome é Sam! Esse é John.\n{====}O produtor nos mandou...{break}";
	["e96a4ada6e8111ea806f3c15c2dd513c"] = "Um nome tão sem graça quanto seus olhos sem vida. PERFEITO! OUH OUH!\n{====}Não importa quem mandou vocês.\n{====}Só EU decido quem vira estrela aqui.\n{====}Então venham, queridos. Me mostrem do que são capazes! Hiiii!";
	["0ac32816b0c511ea96e23c15c2dd513c"] = "{big}Nossa, achei que meus olhos iam pular pra fora! Que espetáculo!\n{====}Você bateu recorde logo na primeira tentativa!\n{====}Nunca vi homem manejar frigideira com tanta destreza!\n{====}{big}Tenho que te dar o papel principal, e você não pode recusar!\n{====}Vem me encontrar no vagão de efeitos especiais, tá bom, querido?\n{====}Hoje só vão falar de você! OUH OUH!";
	["0ac32988b0c511ea96e23c15c2dd513c"] = "Não vou te enganar, querido... Sua atuação foi...\n{====}mediocre.\n{====}Em resumo, se mediocridade fosse combustível e você motor...\n{====}já teria chegado em Éternia!\n{====}Mas calma! É pra isso que estamos aqui, querido. OUH OUH!\n{====}Vamos transformar essa mediocridade em algo tão sensual...\n{====}tão ousado... tão pingando charme necrótico...\n{====}que o público vai querer te comer vivo!\n{====}Está decidido! Vem me encontrar no vagão de efeitos especiais.\n{====}{big}Vou fazer de você a estrela mais medíocre de todos os tempos! HIIII!";
	["19bc88322ca111eb801b3c15c2dd513c"] = "{~}Você... Você é um GÊNIO!\n{====}Que lição... Não acho palavras. Foi prodigioso!\n{====}{big}Ela chegou! Tá aqui! Oh! A inspiração me invade!\n{====}Vejo a cena. A moça...\nO que ela faz? Ela hesita.\n{====}Ela te conforta? Ou cuida do irmão ferido?\n{====}A tensão tá no máximo! E você? Oh, sim... Você, meu caro Georges... Quer dizer, John.\n{====}{big}Você descobre uma paixão inesperada... pelo BEISEBOL!\n{====}Sim, sim, SIM! Perfeito! Já tenho o título ideal!\n{====}O filme vai se chamar... «Amor em três rebatidas»!";
	["19bc8bc02ca111eb801b3c15c2dd513c"] = "MAS ANTES! Temos que terminar essa gravação. HIII!\n{====}{big}Vi tudo que queria. Me encontra no vagão de efeitos especiais, tá bom, querido?";
	["0ac32abeb0c511ea96e23c15c2dd513c"] = "{big}Es-to-nte-an-te. Nunca vi atuação tão loucamente... tão incrivelmente...\n{====}RUIM.\n{====}HIIII! Achou que ia me enganar tão fácil?\n{====}HA! Vejo teu joguinho!\n{====}Esse jeito desajeitado de balançar a frigideira...\n{====}O desconforto que senti com tanta incompetência...\n{====}Isso exige... TALENTO!\n{====}Não é à toa que conquistou o produtor! Você é uma {~}JOIA!\n{====}Me encontra no vagão de efeitos especiais, pode ser, querido?\n{====}Vou fazer de você a ESTRELA do meu próximo filme! OUH OUH!";
	["e96a50ac6e8111ea806f3c15c2dd513c"] = "No trabalho, cambada de inúteis! VAMOS!";
	["e96a52006e8111ea806f3c15c2dd513c"] = "Ouh ouh! Já vou!";
	["e96a53c26e8111ea806f3c15c2dd513c"] = "Euuuh... Tô indo! Chrrr!";
	["e96a55986e8111ea806f3c15c2dd513c"] = "Lá vamos nós! KikiKIIIII!";
	["238e46cf174a11ea9d6f3c15c2dd513c"] = "{<}{big}Consegui uma garrafa de leite de banana recém-espremido.\n{====}O que acha, minha cara? {.}Que tal irmos beber juntos na minha cabine?";
	["238e4873174a11eaa99d3c15c2dd513c"] = "Eca. Parece que tô ouvindo um HUMANO!\n{====}Você me dá nojo! Ouh ouh!";
	["238e4b68174a11eaa4b73c15c2dd513c"] = "Hoho, claro. Entendo. Ouh ouh!\n{====}{big}Pensei que essa abordagem direta desses animais te agradaria.\n{====}Grande erro meu!";
	["238e4da6174a11ea9e073c15c2dd513c"] = "É você o novo?\n{====}Eu sou a estrela principal aqui. Ouh ouh!";
	["238e5038174a11ea9cef3c15c2dd513c"] = "Tomara que a gente faça um bom trabalho junto. Ouh!";
	["238e525e174a11eaa9a83c15c2dd513c"] = "{~}Não fala com Bella como humano!\n{====}Isso a deixa enojada. Ouh ouh!";
	["238e5433174a11eab1c23c15c2dd513c"] = "Esse leite de banana custa os olhos da cara...\n{====}Mais um mês de salário pro ralo! Hiiii!";
	["238e55cc174a11eabea83c15c2dd513c"] = "Querido! Essa batalha final foi absolutamente espetacular! HIIII!";
	["238e57cc174a11eaa5c93c15c2dd513c"] = "Não seria incrível se eu fizesse o papel dela na nossa próxima produção?";
	["238e59fd174a11eabfd63c15c2dd513c"] = "{big}IDEIA FÁBULOSA! Nosso próximo filme vai ser sobre você, você e só VOCÊ! OUH OUH!";
	["238e5be3174a11eabae13c15c2dd513c"] = "Fico pensando o que o jovem mestre vai achar disso. Tomara que não faça birra. Chrrrr!";
	["238e5e70174a11ea983f3c15c2dd513c"] = "Está decidido! Nosso próximo filme será sobre você, você e só VOCÊ!";
	["238e6028174a11eaa9513c15c2dd513c"] = "Beleza, tenho muito trabalho pela frente.";
	["69827ed4f80911eaac1b3c15c2dd513c"] = "Então é essa tua força de verdade? Ouh ouh!\n{====}O produtor realmente sabe encontrar talento... Você é bom!\n{====}Toma, tua recompensa. HIII!";
	["698280bef80911eaac1b3c15c2dd513c"] = "Não adianta fingir! O diretor não tá mais aqui. HIII!\n{==}Vai, me mostra o que tem na barriga! OUH OUH!\n{choice:yes}Tentar de novo\n{choice:no}Não, valeu";
	["69828028f80911eaac1b3c15c2dd513c"] = "Não tá ruim, não tá ruim. Mas não basta.\n{====}Vai, me mostra o que tem na barriga! OUH OUH!\n{choice:yes}Tentar de novo\n{choice:no}Não, valeu";
	["69828168f80911eaac1b3c15c2dd513c"] = "Vai, mais uma vez! Ouh ouh!";
	["69828316f80911eaac1b3c15c2dd513c"] = "O quê, não vai me dizer que vai desistir assim? HIIII!\n{====}{big}Se não mantiver o nível, alguém vai roubar teu papel principal!";
	};
["CH_Jidoro.sq"]={
	["238ad730174a11eaab943c15c2dd513c"] = "Uuh uuh! O que foi essa terrível explosão?\n{====}Quase morri de susto!\n{====}Eles estão filmando uma cena de ação ou algo assim? Hiii!";
	["238ad980174a11eabff63c15c2dd513c"] = "Desculpe muito, senhor!\n{====}Fomos nós... Batemos no seu trem.";
	["238adae8174a11eaa0943c15c2dd513c"] = "{~}Uuh uuh! CHRRR!\n{~}É um ataque de trem? Magnífico!\n{====}Que ideia brilhante, garota! Sou eu, o produtor, aqui.";
	["238adcd1174a11eaac9c3c15c2dd513c"] = "O produtor?";
	["238ade30174a11ea89743c15c2dd513c"] = "Sim, mesmo que alguns ainda me considerem o prefeito. Uuh uuh!\n{====}Isso foi antes da chegada daquele velho entre nós...\n{====}{big}Foi ele quem transformou a gente numa trupe extravagante de atores e diretores!\n{====}Naturalmente fui nomeado produtor,\n{====}{big}embora ainda exerça meus talentos de ator de vez em quando. Uuh uuh!";
	["238ae019174a11ea9eb23c15c2dd513c"] = "Me diz, garota. Você gosta de animações? Uuh uuh!";
	["238ae1a8174a11eaafeb3c15c2dd513c"] = "Oh, sim! EarthBorn é meu filme favorito!";
	["238ae2de174a11ea96ba3c15c2dd513c"] = "{~}Uuh uuh! HIIII! EarthBorn, você disse?\n{====}Fazia tempo que não ouvia esse nome.\n{====}Ah, quando brilhei nos holofotes nesse filme,\n{====}{big}ainda era um jovem chimpanzé arrogante e ávido por glória. Hiii!";
	["238ae614174a11ea8f8d3c15c2dd513c"] = "{~}Você ATUOU em EarthBorn?!\n{====}Qual personagem era?\nO Cavaleiro do Foguete? O caçador? O arquimago?";
	["238ae914174a11eabcf13c15c2dd513c"] = "Hohoho... CHRRR!\n{====}Óbvio que só havia um papel feito pra mim...\n{==}O do macaco! Uuh uuh!";
	["0ac8785cb0c511ea96e23c15c2dd513c"] = "{big}Um momento... Por acaso... vocês ainda têm o foguete do cavaleiro aqui?";
	["0ac879b0b0c511ea96e23c15c2dd513c"] = "O foguete dele? Pensando bem... Acho que vi um aparelho desses.\n{====}Mas você vai ter que perguntar no vagão de armazenamento.\n{====}E já que falei nisso, uma jovem cinéfila como você\n{====}teria vontade de atuar um pouco? Uuh uuh!";
	["0ac899d6b0c511ea96e23c15c2dd513c"] = "Atuar?\n{====}Você quer dizer, num filme de verdade?";
	["0ac89c92b0c511ea96e23c15c2dd513c"] = "Claro! HIII!\n{====}Estamos precisando de gente ultimamente.\n{====}Especialmente humanos que falem direito. Uuh uuh!";
	["0ac89e0eb0c511ea96e23c15c2dd513c"] = "De qualquer forma, vá falar com nosso diretor. Diga que vem da minha parte.\n{====}Ele deve saber mais que eu sobre esse... foguete. Uuh uuh!";
	["0ac89ed6b0c511ea96e23c15c2dd513c"] = "Uuh uuh. CHRRR! Antes de ir, pega isso.\n{====}Um empurrãozinho pra uma jovem apaixonada por cinema. Hiiii!";
	["238aef42174a11ea92e93c15c2dd513c"] = "Fico surpreso que esse filme velho ainda faça sucesso. Uuh uuh!";
	["238af0b3174a11ea9ab63c15c2dd513c"] = "{big}Ah, aí está minha jovem cinéfila favorita! Uuh uuh! E aí, achou seu foguete?\n{====}Me contaram que você arrasou no set!\n{====}Mas não deixe a fama te desviar do que é importante, entendeu? Hiiii!";
	["238af2f8174a11ea82ba3c15c2dd513c"] = "{big}Ah, aí está minha jovem cinéfila favorita! E aí, achou seu foguete?";
	["238af487174a11ea9b233c15c2dd513c"] = "Uuh uuh. De qualquer forma, tenho certeza de que vocês dois estão exaustos.\n{====}Posso mandar alguém levar vocês pra cabine.\n{choice:yes}Descansar\n{choice:no}Ainda não";
	["238b0099174a11eab1503c15c2dd513c"] = "Sem descanso suficiente, o cérebro não funciona direito.\n{====}Não joguem por muito tempo, tá bom? Uuh uuh!\n{====}E principalmente, NADA DE TV!\n{====}{big}Vocês humanos não sabem se controlar com essas telas idiotas. Hiiii!";
	["0ac8a070b0c511ea96e23c15c2dd513c"] = "Uuh uuh! Como pude esquecer algo tão importante?\n{====}Sinto muito por não poder ajudar. Hiiii!";
	["238afb70174a11ea871e3c15c2dd513c"] = "Aí está sua cabine. Uuh uuh!\n{====}Não precisa procurar TV, não tem!\n{====}Vocês humanos vivem grudados nas telas!\n{====}Então o produtor mandou tirar de propósito! HIIII!";
	["238aff0a174a11eaafa63c15c2dd513c"] = "Fico pensando se Alva e Isabel chegaram em Éternia...";
	["238b02dc174a11eaa60d3c15c2dd513c"] = "Abordagem furtiva, hein?\n{====}Cuidado pra não serem vistos.\n{====}{big}Senão vão acabar atrás das grades de novo! Uuh uuh!";
	};
["DamShop_Ch6.sq"]={
	["239218e3174a11eab4153c15c2dd513c"] = "Tudo pronto?";
	["23921aba174a11ea9c8b3c15c2dd513c"] = "O... O-sim, todas as coisas já estão no t... t... trem.";
	["23921b9e174a11ea97843c15c2dd513c"] = "Então, o momento finalmente chegou...";
	["23921cf3174a11ea9ab83c15c2dd513c"] = "Essa cidade realmente nos mimou.\n{====}Vou guardar uma ótima lembrança dela.";
	["23921e33174a11ea85603c15c2dd513c"] = "A g-gente... d-deveria esperar mais uns... q-quantos dias?{stop}";
	["23921efa174a11ea8a7a3c15c2dd513c"] = "De jeito nenhum!\n{====}Se minhas estimativas estiverem certas, eles chegam a qualquer momento.";
	["23922028174a11ea81cc3c15c2dd513c"] = "S... Sam!\n{====}V... V... Você está bem?";
	["239220e6174a11eab67e3c15c2dd513c"] = "Daniel.";
	["239221a3174a11eaaf0c3c15c2dd513c"] = "Você está deixando essa garota em apuros.";
	["2392223a174a11eab7c33c15c2dd513c"] = "Bem... Suponho que querem algo?";
	["2392235c174a11ea91083c15c2dd513c"] = "{<}Éternia?\nInteressante...{|}\n{====}Um lugar fascinante, realmente.\n{====}Porém, a viagem vai custar caro...";
	["2392240f174a11eabd9d3c15c2dd513c"] = "{>}M... Mas eu achava que a gente já t-t-tinha...";
	["2392249c174a11ea85633c15c2dd513c"] = "Desde o dia da nossa primeira reunião...";
	["2392253a174a11ea857d3c15c2dd513c"] = "{<}Não consigo evitar pensar que o destino é bem curioso.";
	["23922605174a11eaa2b93c15c2dd513c"] = "Acontece que nós também estamos indo pro leste.\n{====}{big}E deve-se reconhecer que {<}ter um sujeito incansável como você ao nosso lado\n{====}seria uma vantagem inegável.\n{====}Suficiente pra oferecer uma vaga a bordo pra vocês dois.\n{====}O que acham? Troca justa?\n{====}Me avisem quando decidirem.";
	["239226d7174a11eaacab3c15c2dd513c"] = "Vai ser s... s... super perigoso seguir esses trilhos r... rumo ao leste.\n{====}A gente tem que tomar todas as p... p... precauções.";
	["2392274c174a11ea857c3c15c2dd513c"] = "Pronto pra partir, jovens vagabundos?\n{====}{choice:yes}Vamos nessa!\n{choice:no}Ainda não.";
	["239227c7174a11ea9a203c15c2dd513c"] = "Ótimo! Nos vemos na estação, então.";
	["e2d7c02aaf7811eaa4ed3c15c2dd513c"] = "Acha que vai chover por muito tempo ainda?";
	["e2d7c21eaf7811eaa4ed3c15c2dd513c"] = "Eu odeio essa chuva. Não dá pra fazer nada com esse tempo.";
	["e2d7c3e0af7811eaa4ed3c15c2dd513c"] = "{~}Isso me irrita! Tô louco pra jogar EarthBorn!";
	["e2d7c610af7811eaa4ed3c15c2dd513c"] = "Você não poderia guardar a máquina, sra. Tayama?";
	["e2d7c75aaf7811eaa4ed3c15c2dd513c"] = "{big}Hohoho. Espero que esteja brincando, seu pirralho. Se eu tentar mover essa máquina,\n{====}meus velhos ossos vão quebrar como gravetos.";
	["e2d7c926af7811eaa4ed3c15c2dd513c"] = "Se tanto quer jogar, compra a máquina e leva pra casa.";
	["e2d7c9bcaf7811eaa4ed3c15c2dd513c"] = "Acha que viríamos aqui se tivéssemos tanto dinheiro assim?";
	["e2d7ca98af7811eaa4ed3c15c2dd513c"] = "Essa chuva maldita nunca vai parar...";
	["e2d7cb4caf7811eaa4ed3c15c2dd513c"] = "Ah, é a Sam.{stop}";
	["e2d7cbd8af7811eaa4ed3c15c2dd513c"] = "Dizem que a princesa nos abandonou. Você sabe se é verdade?";
	["e2d7cd04af7811eaa4ed3c15c2dd513c"] = "Que nada! A princesa nunca faria isso!";
	["e2d7cf98af7811eaa4ed3c15c2dd513c"] = "É a Isabel... Ela levou Alva pra Éternia.";
	["e2d7d18caf7811eaa4ed3c15c2dd513c"] = "Éternia? Você tá falando da cidade do leste?";
	["e2d7d312af7811eaa4ed3c15c2dd513c"] = "A única e verdadeira.";
	["e2d7d448af7811eaa4ed3c15c2dd513c"] = "Achei que era só lenda.";
	["e2d7d54caf7811eaa4ed3c15c2dd513c"] = "Eu também, mas se Isabel tá indo pra lá...\n{====}deve significar que ela existe mesmo?";
	["e2d7d72caf7811eaa4ed3c15c2dd513c"] = "Claro que existe.";
	["e2d7d916af7811eaa4ed3c15c2dd513c"] = "Hein? Você sabe algo sobre Éternia, sra. Tayama?\n{====}Sabe como chegar lá?";
	["e2d7dbbeaf7811eaa4ed3c15c2dd513c"] = "Ha! Como eu saberia uma coisa dessas?\n{====}Mas garanto que ela existe mesmo.\n{====}Porque o avô da nossa princesa... era de lá.";
	["e2d7de3eaf7811eaa4ed3c15c2dd513c"] = "O avô da Alva... era de Éternia?";
	["e2d7df2eaf7811eaa4ed3c15c2dd513c"] = "Procuram o William?\n{====}{big}Ele tá na loja dos fundos. Mas se apressem, parece ansioso pra ir embora.";
	["e2d7e046af7811eaa4ed3c15c2dd513c"] = "Vocês!";
	["e2d7e276af7811eaa4ed3c15c2dd513c"] = "Sim... VOCÊS!\n{====}Eu reconheço vocês.\n{====}São vocês que vão partir com aquele jovem charmoso de cabelo roxo.\n{====}Pode pedir uma coisa por mim?\n{====}Quero saber se ele teria a bondade...\n{====}de assumir minha loja quando voltar?";
	["e2d7e438af7811eaa4ed3c15c2dd513c"] = "Sem pressa, claro.\n{====}Vou esperar pacientemente.\n{====}Pelo tempo que for preciso...";
	["e2d7e4d8af7811eaa4ed3c15c2dd513c"] = "E agora, sumam!\n{====}Estranho... Devo ter uma poeira no olho...";
	["23921311174a11eab9db3c15c2dd513c"] = "Vocês vão mesmo pra Éternia também?";
	["2392147a174a11eab3703c15c2dd513c"] = "Éternia fica super longe no leste.\n{====}O único jeito de ir,\n{====}{big}é seguir a grande linha! É isso que pretendem fazer?";
	["239215ba174a11ea8bde3c15c2dd513c"] = "Todo mundo adora a princesa Alva, mas...\n{====}essa Isabel, ela é... meio assustadora...";
	["fdb47308526011eba6373c15c2dd513c"] = "Pai!{stop}";
	["fdb4747a526011eba6373c15c2dd513c"] = "Os consertos aca... acabaram?{stop}";
	["fdb47704526011eba6373c15c2dd513c"] = "É! Tô m... muito melhor!{stop}";
	["fdb478d0526011eba6373c15c2dd513c"] = "É s... super!{stop}";
	["fdb47934526011eba6373c15c2dd513c"] = "Se tudo correr bem, podemos partir amanhã.{stop}";
	["fdb4797a526011eba6373c15c2dd513c"] = "{<}Amanhã...{stop}";
	};
