["west_01.sq"]={
	["2383f9a8174a11eaa3093c15c2dd513c"] = "{<}O outono acabara de começar.\n{====}O solo ressecado ainda guardava o calor do verão.\n{====}No entanto, a mordida do inverno já se fazia sentir na brisa.\n{====}Mas, acima de tudo...\n{====}era um belo dia para morrer.\n{====}Um sentimento de inquietude pairava no ar.\n{====}Por toda parte, a vida passava por estranhas... mudanças.\n{====}Gado, vegetação...\n{====}Todos os seres vivos estavam se transformando em criaturas repugnantes e irreconhecíveis.\n{====}Num caminho de montanha varrido pelo vento,\n{====}uma aura de carnificina impregnava o cenário.\n{====}{big}Então surgiu um homem, com o traje impecável, o dedo trêmulo sobre o gatilho de seu velho rifle, ansioso para fazer o pó falar.\n{====}{<}{wait:1}Era ELE.";
	["2383fbb0174a11ea82123c15c2dd513c"] = "{~}MAGNÍFICO, tesouro !";
	["2383fcc7174a11ea8da63c15c2dd513c"] = "Essa atitude despreocupada !\nEsse carisma apático !\n{====}Uma entrada em cena perfeita, tesouro ! Absolutamente perfeita !\n{====}Deixe esse sentimento de indiferença te dominar.\nDe te consumir !\n{====}Não mude nada !\n{====}Bem, os figurantes estão prontos ?\nCena 15 : « Encontro ruim ».\n{====}Prontos ? E...{signal:e}\n{==}{~}AÇÃO ! UH UH !";
	["23840007174a11eaaaa83c15c2dd513c"] = "Excepcional ! Uma atuação realmente comovente !";
	["23840126174a11eab9c13c15c2dd513c"] = "Massacre sem piedade todos esses sapos !\n{====}Não se esqueça, tesouro ! Sua arma é a única justiça deste mundo !\n{====}Cena 16 : « Massacre num beco » !\n{====}Prontos ? E...{signal:e}\n{==}{~}AÇÃO ! UH UH !";
	["23840235174a11eab03b3c15c2dd513c"] = "Suas vítimas jaziam no chão como ervas pisoteadas.\n{====}Os disparos de sua arma soavam como sinos de morte.\n{====}Nada mais podia impedir aquele exterminador de alcançar seu objetivo.";
	["23840428174a11ea9ddd3c15c2dd513c"] = "No ar, criaturas imundas e bestas infernais rugiam.\n{====}Mas suas horas estavam contadas.\n{====}O dia do julgamento havia chegado.\n{====}Podiam abrir suas terríveis mandíbulas o quanto quisessem, mas todas terminariam com uma bala entre os olhos...\n{====}miolos e entranhas espalhados pelos quatro cantos do cenário.";
	["238405d7174a11ea8b883c15c2dd513c"] = "Uh uh ! HIIIIIIIIII !\n{====}Eu não me enganei sobre você !\n{====}Continue assim, tesouro ! Que TALENTO !\n{====}Vamos para a cena 17 : « Fritada de rãs » !\n{====}Prontos ? E...{signal:e}\n{==}{~}AÇÃO ! UH UH !";
	["23840807174a11ea8a813c15c2dd513c"] = "Maravilhoso ! Espetacular ! Isso é arte pura !\n{====}Você é o maior atirador de todos os tempos, tesouro !\n{====}Mas o verdadeiro desafio começa agora !\n{====}Mostre a eles do que você REALMENTE é capaz !\n{====}Cena 18 : « Briga intergaláctica » !\n{====}Prontos ? E...{signal:e}\n{==}{~}AÇÃO ! UH UH !";
	["2384096e174a11eabb263c15c2dd513c"] = "As sombras se estendiam ao pé dos prédios...\n{====}enquanto um imenso asteroide incendiava o céu.\n{====}O vil inimigo do mundo finalmente havia chegado.";
	["23840c19174a11eab1af3c15c2dd513c"] = "Alerta ! Alerta !\n{====}Objeto massivo se aproximando !{stop}";
	["23840dcf174a11eaacdf3c15c2dd513c"] = "« Super Extra Man... ! »\n{====}« TRANSFORMAÇÃÃÃÃÃO ! »{stop}";
	["2384109e174a11ea87b13c15c2dd513c"] = "« SOCORROOO ! »\n{====}Os gritos de uma jovem em perigo se ergueram dos escombros.";
	["238412e3174a11eab7c03c15c2dd513c"] = "« Socorro ! Ajude-me, Super Extra Man ! »";
	["23841545174a11ea8f633c15c2dd513c"] = "« Perdoe-me, senhorita. »\n{====}« A sua vida pesa pouco nesta batalha... »\n{====}« É o destino do mundo que está em jogo aqui. »\n{====}« Sinto muito... »";
	["23841730174a11eabd333c15c2dd513c"] = "« E você ainda diz que é um herói ! »";
	["238418ca174a11eab4fc3c15c2dd513c"] = "« Deixe-me protegê-la, senhorita ! »";
	["23841adc174a11eaa1193c15c2dd513c"] = "CORTAAAA !{stop}";
	["23841c8a174a11ea918f3c15c2dd513c"] = "Notável ! Sensacional !{~} Isso é arte de verdade ! HIII !\n{====}Bella, você é uma DEUSA do cinema !\n{====}{big}Ver você em cena é como ver Vênus emergir de sua concha...\n{====}{big}e varrer de uma vez todas as nossas definições grosseiras de beleza !\n{====}Só a sua voz poderia fazer as muralhas do paraíso\n{====}tremerem de êxtase !\n{==}Realmente, não vejo QUEM poderia assumir esse papel melhor que...{stop}";
	["23841df0174a11eaaf3c3c15c2dd513c"] = "{~}Ah, chega de elogios, Favoloso. Chrrr !\n{====}Só quero terminar essa cena. Tenho hora no cabeleireiro.";
	["23842005174a11ea8b973c15c2dd513c"] = "Claro, tesouro ! Mil desculpas !\n{====}HUM !";
	["23842157174a11eaaa563c15c2dd513c"] = "Muito bem, retomemos !\n{====}Sua missão é simples : você deve proteger Bella, mesmo que custe sua vida ! HIIII !\n{====}{big}Não deixe esses vis sapos\ntocarem num fio do lindo queixo dela,\nestá claro ?\n{====}Cena 20 : « Um verdadeiro herói » !\n{====}Prontos ? E...\n{==}{~}AÇÃO ! UH UH !";
	["238423cf174a11ea8cf93c15c2dd513c"] = "« Meu HERÓI ! »\n{====}« Posso ao menos saber o seu nome ? »";
	["238424a1174a11ea87263c15c2dd513c"] = "« Jake ? Que nome DOS SONHOS ! »\n{====}« E que coincidência conveniente... »\n{====}« Porque é tudo o que você será em breve ! Prepare-se pra morrer, Jake ! »";
	["2384282e174a11ea9a0c3c15c2dd513c"] = "« Você... Você não vai ficar ? »";
	["2384290a174a11eaa92e3c15c2dd513c"] = "« Ficar ? »\n{====}« Com esse herói de araque ? »\n{====}« Por que não com esse monstro maquiavélico, já que estamos nisso ? »\n{====}« Não, sinto muito, mas acabou. Tenho que dizer... adeus. »";
	["238429d1174a11ea831a3c15c2dd513c"] = "E assim continuou o confronto entre os dois colossos poderosos.\n{====}Jake nunca olhou para trás, os olhos sempre voltados para o infinito do céu noturno.";
	["0ac6a5a4b0c511ea96e23c15c2dd513c"] = "{~~}EXTRAORDINÁRIO ! UH UH !";
	["23842bc5174a11ea9e2e3c15c2dd513c"] = "Eu sabia que você estaria à altura, tesouro !\n{====}A fera selvagem que dormia dentro de você finalmente despertou !\n{====}Você é verdadeiramente... uma {~}ESTRELA do cinema ! UH UH !";
	["23842c7a174a11ea971e3c15c2dd513c"] = "E Bella ! Bella, tesouro !\nVocê também, você...{stop}";
	["0ac6ab9eb0c511ea96e23c15c2dd513c"] = "Era só isso ?\n{====}Tenho coisas a fazer. Uh uh !";
	["23842e1e174a11ea81d93c15c2dd513c"] = "Claro, tesouro ! Claro !";
	["23842eb5174a11eab2503c15c2dd513c"] = "Ouviram isso ? Está na caixa !\n{==}{~}Guardem tudo, pessoal ! UH UH !";
	["0ac6ad1ab0c511ea96e23c15c2dd513c"] = "Tenho que admitir, estou impressionada.\n{====}Espero que tenhamos o prazer de trabalhar juntos novamente. Uh uh !";
	["2384304f174a11ea90163c15c2dd513c"] = "Senhorita Bella ! Por aqui, por favor !";
	["23843133174a11ea9dc73c15c2dd513c"] = "John !";
	["23843261174a11ea8edc3c15c2dd513c"] = "Você é uma estrela agora !\nUma estrela de verdade !";
	["23843363174a11eaa0d93c15c2dd513c"] = "E isso é só o começo, tesouro !";
	["23843454174a11ea85003c15c2dd513c"] = "Estou completamente emocionado, de verdade !\n{====}Quem diria que um humano poderia me causar esse efeito ? HIII !\n{====}Agora, vão ver o produtor, vocês dois.\n{====}Aquele velhaco deve estar na cabine, no fim do trem.\n{====}Ele vai lhes dar um camarim, vocês precisam descansar.\n{====}As grandes estrelas precisam se poupar, sabem ? UH UH !";
	["5f5b52fcb13511ea9dc73c15c2dd513c"] = "{big}E o foguete ? Nós estávamos aqui por causa do foguete do cavaleiro, lembra !";
	["5f5b5504b13511ea9dc73c15c2dd513c"] = "{big}O Cavaleiro do Foguete, quer dizer ? Uh uh ! Você não está falando de EarthBorn, tesouro ?\n{====}{big}Estou surpreso que uma garotinha adorável como você conheça esse clássico antigo !\n{====}Quanto a esse foguete...";
	["5f5b5586b13511ea9dc73c15c2dd513c"] = "Talvez o encontrem no vagão de carga, a leste. Hiiii !\n{====}Está lotado de velhos acessórios !";
	["5f5b5716b13511ea9dc73c15c2dd513c"] = "Enquanto isso, aproveitem bem o momento de glória, tesouros.\n{====}Soltem-se ! Gastem sem pensar !\n{====}Enfim, façam o que todas as outras celebridades fazem ! Uh uh !";
	["238436e8174a11ea93b03c15c2dd513c"] = "{~}{>}CORTAAAA !{stop}";
	["238437ba174a11ea801c3c15c2dd513c"] = "Pelo shortinho da minha tia-avó, o que foi ISSO ? HIIII !\n{====}Jake não pode perder pra aquela brutamontes !\n{====}Vamos começar do início ! UH UH !";
	["238438a8174a11eaafb33c15c2dd513c"] = "{big}Pela cueca reforçada do primo do meu dentista, o que foi ISSO ?\n{====}Você deveria ser um durão !\nUm beatnik animalesco !\n{====}Não pode deixar esses fracotes\n{====}{big}chutarem seu traseiro como uma vovozinha em noite de bingo !\n{====}Vamos começar do início ! HIII !";
	["238439a3174a11ea8e513c15c2dd513c"] = "{big}Um homem surgiu, com o traje impecável, o dedo trêmulo sobre o gatilho de seu velho rifle, ansioso para fazer o pó falar.\n{====}{<}{wait:1}Era ELE.";
	["23843b8f174a11eabeea3c15c2dd513c"] = "Nada mais podia impedir aquele exterminador de alcançar seu objetivo.";
	["23843e5e174a11eaacba3c15c2dd513c"] = "Mas suas horas estavam contadas.\n{====}O dia do julgamento havia chegado.\n{====}Podiam abrir suas terríveis mandíbulas o quanto quisessem, mas todas terminariam com uma bala entre os olhos...\n{====}miolos e entranhas espalhados pelos quatro cantos do cenário.";
	["2384407a174a11ea91e53c15c2dd513c"] = "O vil inimigo do mundo finalmente havia chegado.";
	["23844214174a11eab0a23c15c2dd513c"] = "« Deixe-me protegê-la, senhorita ! »";
	["69856b08f80911eaac1b3c15c2dd513c"] = "« Prepare-se pra morrer, Jake ! »";
	["2384437a174a11eab6643c15c2dd513c"] = "{~}{<}CHEGA ! HIIII !\n{====}{|}Me recuso a continuar com esse... esse ator de fim de semana !\n{====}Ele COSPE em mim !\n{====}Esse amador é incapaz de proteger uma dama !";
	["23844475174a11eaa6fc3c15c2dd513c"] = "Ei, calma aí.\n{====}Todo mundo tranquilo, certo ?\n{====}Ele está começando, vamos dar outra chance. Vai ficar tudo bem ! Uh uh !";
	["23844547174a11eab2fa3c15c2dd513c"] = "Você ! Faça um esforço !\n{====}Isto é um grande filme, não uma produçãozinha barata !\n{====}Vamos começar do início ! UH UH !";
	["23844673174a11ea81833c15c2dd513c"] = "E agora, chegou o seu momento favorito...\n{====}a enciclopédia dos monstros !";
	["23844733174a11eaa7373c15c2dd513c"] = "Sobre qual criatura vamos falar hoje, hein ?";
	["238448a3174a11eab0f93c15c2dd513c"] = "Vou contar tudo sobre uma criatura que todo mundo adora...\n{====}{~}a raia-faísca flamejante !";
	["238449a8174a11eab55f3c15c2dd513c"] = "Ei ! Vocês dois ! Isso mesmo, vocês ! Estão aparecendo na cena !\n{====}Saiam daí !";
	["23844aa3174a11ea86d63c15c2dd513c"] = "Deixem-me trabalhar !";
	["23844b7d174a11ea8cb63c15c2dd513c"] = "Aí está a estrela.";
	["23844cc7174a11eab1cc3c15c2dd513c"] = "O quê, ainda quer nos bater ?\n{====}Haha. Calma, é brincadeira.";
	["2384524a174a11ea96f73c15c2dd513c"] = "Você se saiu surpreendentemente bem.\n{====}A ponto de eu achar que é um atirador de elite.";
	["2384538a174a11ea950c3c15c2dd513c"] = "Não seja ridículo.\n{====}Os atiradores de elite não existem mais.";
	["23845519174a11eaa0183c15c2dd513c"] = "Mas essa arma...\n{====}É realmente poderosa.";
	["2384563a174a11ea895b3c15c2dd513c"] = "Se não fôssemos mestres do croaratê,\n{====}certamente estaríamos cheios de buracos !";
	["23845880174a11eaa3f03c15c2dd513c"] = "De qualquer forma, foi um belo trabalho.\n{====}Talvez seja até o começo de uma bela amizade ?";
	["23845a68174a11ea96db3c15c2dd513c"] = "Espero que façamos um ótimo filme juntos !";
	["23845d11174a11eab1bb3c15c2dd513c"] = "Incrível. É a primeira vez que um humano consegue o papel principal.\n{====}O diretor realmente tem coragem.";
	["23845f9c174a11eabd983c15c2dd513c"] = "Tem certeza de que não é um atirador de elite ?";
	["238461c2174a11ea91103c15c2dd513c"] = "Espero que façamos um ótimo filme juntos !";
	["238462cf174a11eaa4103c15c2dd513c"] = "A paisagem nessa pintura...\nÉ estranhamente familiar.\n{====}Será que já estivemos lá antes ?";
	["23846399174a11ea91253c15c2dd513c"] = "T... Você esqueceu ?\n{====}Foi l... lá que encontramos aqueles d... d... desenvolvedores de jogos.\n{====}V... Você até vendeu pra eles um v... v... videogame.";
	["238464a6174a11ea97e23c15c2dd513c"] = "Ah, é mesmo.\n{====}Agora que você falou, de fato me lembro disso...";
	["23846578174a11ea86203c15c2dd513c"] = "Videogames, hein ?\n{====}Um mercado potencialmente lucrativo...";
	["2384676b174a11eaadbc3c15c2dd513c"] = "F... Fico me p... perguntando se eles conseguiram terminar o j... j... jogo.";
	};
